<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title><%= typeof title !== "undefined" ? title : "Snack Delivery" %></title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Sora:wght@500;600;700;800&display=swap"
    rel="stylesheet"
  />
  <link rel="stylesheet" href="/css/main.css" />
</head>

<body class="landing-body">
  <main class="landing-page landing-page-editorial">
    <section class="landing-stage">
      <img
        src="/homepage_images/Restaurant_items.avif"
        alt="Assorted meals ready for delivery"
        class="landing-stage-image"
      />

      <nav class="landing-nav landing-nav-overlay" aria-label="Landing navigation">
        <a href="/" class="landing-brand landing-brand-light" aria-label="Snack landing page">
          <img src="/images/snack-logo.svg" alt="Snack logo" width="42" height="42" />
          <span>Snack</span>
        </a>

        <div class="landing-nav-actions">
          <a href="/auth/login" class="landing-link landing-link-light">Sign In</a>
          <a href="/auth/signup?accountType=customer" class="landing-nav-cta">
            Sign Up
          </a>
        </div>
      </nav>

      <% if (typeof success !== "undefined" && success.length) { %>
        <div class="flash flash-success landing-flash landing-flash-overlay">
          <%= success[0] %>
        </div>
      <% } %>

      <% if (typeof error !== "undefined" && error.length) { %>
        <div class="flash flash-error landing-flash landing-flash-overlay">
          <%= error[0] %>
        </div>
      <% } %>

      <div class="landing-stage-content">
        <span class="landing-kicker landing-kicker-light">Snack Delivery</span>
        <h1>Sign in. Order well. Eat sooner.</h1>
        <p>
          Create a Snack account to discover local restaurants, save your
          delivery details, and track every order from one clean place.
        </p>

        <div class="landing-actions landing-stage-actions">
          <a href="/auth/signup?accountType=customer" class="landing-primary-action">
            Create Customer Account
          </a>
          <a href="/auth/login" class="landing-secondary-action landing-secondary-action-dark">
            Sign In
          </a>
        </div>

        <a href="/home" class="landing-browse-link landing-browse-link-light">
          Browse restaurants first
        </a>
      </div>

      <div class="landing-stage-strip" aria-label="Snack highlights">
        <div>
          <strong>25 min</strong>
          <span>average handoff</span>
        </div>
        <div>
          <strong>Saved</strong>
          <span>delivery details</span>
        </div>
        <div>
          <strong>Live</strong>
          <span>order tracking</span>
        </div>
      </div>
    </section>

    <section class="landing-food-story" aria-label="Snack app preview">
      <div class="landing-story-copy">
        <span class="landing-kicker">Built for hungry customers</span>
        <h2>A calmer way to get from craving to checkout.</h2>
        <p>
          Snack keeps the first step simple: sign in, choose a restaurant, add
          the food you want, and keep your order history in reach.
        </p>
      </div>

      <div class="landing-photo-row">
        <figure>
          <img src="/homepage_images/meat.avif" alt="Grilled meat dish" loading="lazy" />
          <figcaption>Hot dinner picks</figcaption>
        </figure>
        <figure>
          <img src="/homepage_images/greek.avif" alt="Fresh bowl meal" loading="lazy" />
          <figcaption>Fresh everyday meals</figcaption>
        </figure>
        <figure>
          <img
            src="/images/1777022534500-burger_0__FocusFillWyIwLjAwIiwiMC4wMCIsODAwLDQ3OF0_CompressedW10-800.jpg"
            alt="Burger meal"
            loading="lazy"
          />
          <figcaption>Fast favorites</figcaption>
        </figure>
      </div>
    </section>

    <section class="landing-signup-band" aria-label="Customer account benefits">
      <div>
        <span class="landing-kicker">Customer account</span>
        <h2>Your next order should feel familiar.</h2>
      </div>

      <ul>
        <li>Save delivery details for faster checkout.</li>
        <li>Track your order history after signing in.</li>
        <li>Return to the restaurants and meals you already know.</li>
      </ul>
    </section>

    <section class="landing-partnerships landing-partnerships-editorial" aria-labelledby="landing-partnership-title">
      <div class="landing-section-head">
        <span class="landing-kicker">Partner with Snack</span>
        <h2 id="landing-partnership-title">Restaurants and drivers can join from here too.</h2>
        <p>
          Snack supports the customers ordering food, the kitchens preparing it,
          and the drivers moving it across town.
        </p>
      </div>

      <div class="landing-partner-grid landing-partner-grid-editorial">
        <article class="landing-partner-panel">
          <img src="/homepage_images/Restaurant_items.avif" alt="Restaurant dishes" loading="lazy" />
          <div>
            <span>Restaurants and food businesses</span>
            <h3>Register your business and start taking orders.</h3>
            <p>
              Create a branded restaurant page, upload your menu, and manage
              orders from a focused business dashboard.
            </p>
            <a href="/auth/signup?accountType=owner">Register Business</a>
          </div>
        </article>

        <article class="landing-partner-panel landing-partner-panel-alt">
          <img src="/images/Food_deliivery.jpg" alt="Prepared food for delivery" loading="lazy" />
          <div>
            <span>Delivery drivers</span>
            <h3>Deliver with Snack and keep each route organized.</h3>
            <p>
              Sign up as a driver to accept delivery jobs, update journey
              stages, and track active work from your driver hub.
            </p>
            <a href="/auth/signup?accountType=driver">Apply to Drive</a>
          </div>
        </article>
      </div>
    </section>
  </main>
</body>
</html>
