<%- include("partials/header", { bodyClass: "home-sidebar-layout" }) %>

<%
  const safeVendors = vendors || [];
  const safeVendorTypes = vendorTypes || [];
  const safePopularItems = popularItems || [];
  const fallbackVendorImages = [
    "/homepage_images/Restaurant_items.avif",
    "/homepage_images/papa-johns-banner.webp",
    "/homepage_images/PizzaInnBanner.jpg",
    "/homepage_images/meat.avif",
    "/homepage_images/greek.avif"
  ];
  const marketplaceCategories = [
    { name: "Asian", detail: "Noodles, rice, and more", tone: "red", image: "/homepage_images/Noodles_Icon.png" },
    { name: "Pizza", detail: "Slices and sides", tone: "orange", image: "/homepage_images/Pizza_Icon.jpg" },
    { name: "Chicken", detail: "Crispy favorites", tone: "gold", image: "/homepage_images/Chicken_Icon.jpg" },
    { name: "Burgers", detail: "Stacked and saucy", tone: "green", image: "/homepage_images/Burger_Icon.jpg" },
    { name: "Healthy", detail: "Bowls and salads", tone: "teal", image: "/homepage_images/Salad_Icon.jpg" },
    { name: "Dessert", detail: "Sweet finishes", tone: "pink", image: "/homepage_images/Cake_Icon.jpg" }
  ];
  const filterChips = [
    "Fastest nearby",
    "Offers",
    "Top rated",
    "Under 30 min",
    "Pickup",
    "New on Snack"
  ];
  const vendorBadges = ["Free delivery", "Top rated", "Great value", "Fast delivery"];
  const vendorItems = safePopularItems.reduce((groups, item) => {
    const key = String(item.vendor_id);
    groups[key] = groups[key] || [];
    groups[key].push(item);
    return groups;
  }, {});
  const heroVendor = safeVendors[0] || {};
  const heroImage =
    heroVendor.banner_url ||
    safePopularItems[0]?.image_url ||
    "/homepage_images/Restaurant_items.avif";
  const spotlightItems = safePopularItems.slice(0, 8);
%>

<div class="marketplace-home-layout">
  <aside class="marketplace-side-menu" aria-label="Snack menu">
    <nav class="side-menu-section" aria-label="Home sections">
      <span class="side-menu-section-title">Menu</span>
      <a href="#marketplace-top" class="side-menu-link side-menu-link-active">
        <span class="side-menu-icon" aria-hidden="true">H</span>
        <span>Home</span>
      </a>
      <a href="#marketplace-categories" class="side-menu-link">
        <span class="side-menu-icon" aria-hidden="true">C</span>
        <span>Categories</span>
      </a>
      <a href="#marketplace-highlights" class="side-menu-link">
        <span class="side-menu-icon" aria-hidden="true">%</span>
        <span>Offers</span>
      </a>
      <a href="#popular-now" class="side-menu-link">
        <span class="side-menu-icon" aria-hidden="true">*</span>
        <span>Popular</span>
      </a>
      <a href="#featured-vendors" class="side-menu-link">
        <span class="side-menu-icon" aria-hidden="true">V</span>
        <span>Vendors</span>
      </a>
    </nav>

    <nav class="side-menu-section" aria-label="Account links">
      <span class="side-menu-section-title">Account</span>
      <a href="/orders" class="side-menu-link">
        <span class="side-menu-icon" aria-hidden="true">O</span>
        <span>Orders</span>
      </a>
      <a href="/cart" class="side-menu-link">
        <span class="side-menu-icon" aria-hidden="true">B</span>
        <span>Cart</span>
      </a>
      <% if (typeof currentUser !== "undefined" && currentUser?.role === "driver") { %>
        <a href="/driver" class="side-menu-link">
          <span class="side-menu-icon" aria-hidden="true">D</span>
          <span>Driver Hub</span>
        </a>
      <% } else if (typeof currentUser !== "undefined" && ["owner", "admin"].includes(currentUser?.role)) { %>
        <a href="/admin" class="side-menu-link">
          <span class="side-menu-icon" aria-hidden="true">B</span>
          <span>Business Hub</span>
        </a>
      <% } %>
      <button type="button" class="side-menu-link" data-theme-toggle>
        <span class="side-menu-icon" aria-hidden="true">T</span>
        <span>Dark Mode</span>
      </button>
    </nav>

    <div class="side-menu-account">
      <% if (typeof currentUser !== "undefined" && currentUser) { %>
        <span class="side-menu-avatar" aria-hidden="true"><%= currentUser.email.charAt(0).toUpperCase() %></span>
        <div>
          <strong><%= currentUser.email %></strong>
          <a href="/auth/logout">Logout</a>
        </div>
      <% } else { %>
        <a href="/auth/login" class="side-menu-auth">Sign In</a>
        <a href="/auth/signup" class="side-menu-auth side-menu-auth-primary">Register</a>
      <% } %>
    </div>
  </aside>

<section class="marketplace-page" id="marketplace-top">
  <section class="marketplace-hero" aria-label="Food delivery marketplace">
    <div class="marketplace-hero-copy">
      <span class="marketplace-kicker">Snack marketplace</span>
      <h1>Food, groceries, and more from vendors near you.</h1>

      <form class="marketplace-search" method="GET" action="/vendors/search">
        <label class="sr-only" for="marketplace-search-input">Search vendors</label>
        <span class="marketplace-search-icon" aria-hidden="true">Search</span>
        <input
          id="marketplace-search-input"
          type="text"
          name="search"
          value="<%= searchQuery || "" %>"
          placeholder="Search vendors or items"
          aria-label="Search vendors or items"
        />
        <button type="submit">Find Food</button>
      </form>

      <% if (vendorNotFound) { %>
        <p class="flash flash-error home-search-feedback">
          No vendor matched "<%= searchQuery %>". Try another name.
        </p>
      <% } %>

      <div class="marketplace-order-controls" aria-label="Order options">
        <button class="marketplace-control-active" type="button">Delivery</button>
        <button type="button">Pickup</button>
        <span>ASAP</span>
      </div>
    </div>

    <a href="<%= heroVendor.id ? `/vendor/${heroVendor.id}/menu` : "#featured-vendors" %>" class="marketplace-hero-card">
      <img src="<%= heroImage %>" alt="<%= heroVendor.name || "Featured vendor food" %>" />
      <div>
        <span>Featured near you</span>
        <strong><%= heroVendor.name || "Local vendor picks" %></strong>
        <small>Explore menus, prices, and fast checkout.</small>
      </div>
    </a>
  </section>

  <section class="marketplace-category-rail" id="marketplace-categories" aria-label="Popular categories">
    <% marketplaceCategories.forEach((category) => { %>
      <a href="#featured-vendors" class="marketplace-category-card">
        <span class="marketplace-category-art marketplace-category-<%= category.tone %> <%= category.image ? "marketplace-category-image" : "" %>">
          <% if (category.image) { %>
            <img src="<%= category.image %>" alt="" loading="lazy" />
          <% } %>
        </span>
        <strong><%= category.name %></strong>
        <small><%= category.detail %></small>
      </a>
    <% }) %>
  </section>

  <section class="marketplace-filter-bar" aria-label="Vendor filters">
    <% filterChips.forEach((chip, index) => { %>
      <a href="#featured-vendors" class="<%= index === 0 ? "marketplace-filter-active" : "" %>">
        <%= chip %>
      </a>
    <% }) %>
  </section>

  <section class="marketplace-deals" id="marketplace-highlights" aria-label="Marketplace highlights">
    <article>
      <span>Featured offer</span>
      <strong>Free delivery on every order</strong>
      <a href="#featured-vendors">Browse offers</a>
    </article>
    <article>
      <span>Order faster</span>
      <strong>Popular items are ready to add from the home page</strong>
      <a href="#popular-now">See popular picks</a>
    </article>
    <article>
      <span>Local favorites</span>
      <strong><%= safeVendors.length %> vendors available now</strong>
      <a href="#featured-vendors">View vendors</a>
    </article>
  </section>

  <section class="marketplace-section" id="popular-now">
    <div class="marketplace-section-head">
      <div>
        <span>Popular now</span>
        <h2>Most ordered near you</h2>
      </div>
      <a href="/cart">View cart</a>
    </div>

    <% if (spotlightItems.length > 0) { %>
      <div class="marketplace-item-row">
        <% spotlightItems.forEach((item, index) => { %>
          <article class="marketplace-item-card">
            <a href="/vendor/<%= item.vendor_id %>/menu" class="marketplace-item-image">
              <% if (item.image_url) { %>
                <img src="<%= item.image_url %>" alt="<%= item.name %>" loading="lazy" />
              <% } else { %>
                <span>Popular pick</span>
              <% } %>
            </a>

            <div class="marketplace-item-body">
              <span><%= item.vendor_name %></span>
              <h3><%= item.name %></h3>
              <p><%= item.category || "Customer favorite" %> · <%= 18 + (index % 4) * 4 %>-<%= 26 + (index % 4) * 4 %> min</p>
              <div>
                <strong><%= formatCurrency(item.price) %></strong>
                <button
                  type="button"
                  data-popular-add
                  data-id="<%= item.id %>"
                  data-name="<%= item.name %>"
                  data-price="<%= item.price %>"
                  data-vendor="<%= item.vendor_id %>"
                >
                  Add
                </button>
              </div>
            </div>
          </article>
        <% }) %>
      </div>
    <% } else { %>
      <p class="home-empty-state">Popular items will appear here after menu items are added.</p>
    <% } %>
  </section>

  <section class="marketplace-section" id="featured-vendors">
    <div class="marketplace-section-head">
      <div>
        <span>Vendors near you</span>
        <h2>Order from local favorites</h2>
      </div>
      <a href="/cart">Open cart</a>
    </div>

    <% if (safeVendorTypes.length > 0) { %>
      <div class="marketplace-vendor-type-filter" aria-label="Filter by vendor type">
        <button type="button" class="vendor-type-filter-chip vendor-type-filter-active" data-vendor-type-filter="all">All</button>
        <% safeVendorTypes.forEach((type) => { %>
          <button type="button" class="vendor-type-filter-chip" data-vendor-type-filter="<%= type.value %>"><%= type.label %>s</button>
        <% }) %>
      </div>
    <% } %>

    <% if (safeVendors.length === 0) { %>
      <p class="home-empty-state">No vendors found.</p>
    <% } %>

    <div class="marketplace-vendor-grid" id="vendor-grid">
      <% safeVendors.forEach((vendor, index) => { %>
        <%
          const etaStart = 18 + (index % 5) * 3;
          const etaEnd = etaStart + 10;
          const rating = (4.8 - (index % 4) * 0.1).toFixed(1);
          const badge = vendorBadges[index % vendorBadges.length];
          const bannerImage = vendor.banner_url || fallbackVendorImages[index % fallbackVendorImages.length];
          const previewItems = vendorItems[String(vendor.id)] || [];
        %>

        <a href="/vendor/<%= vendor.id %>/menu" class="marketplace-vendor-card" data-vendor-type="<%= vendor.vendor_type %>">
          <div class="marketplace-vendor-media">
            <img src="<%= bannerImage %>" alt="<%= vendor.name %> food" loading="lazy" />
            <span class="marketplace-store-badge"><%= badge %></span>
          </div>

          <div class="marketplace-vendor-content">
            <div class="marketplace-vendor-title">
              <div>
                <h3><%= vendor.name %></h3>
                <p><span class="vendor-type-tag"><%= vendor.vendor_type_label %></span> · <%= etaStart %>-<%= etaEnd %> min · Free delivery</p>
              </div>
              <strong><%= rating %></strong>
            </div>

            <p class="marketplace-vendor-description">
              <%= vendor.description || "Freshly prepared meals with smooth ordering and quick checkout." %>
            </p>

            <% if (previewItems.length > 0) { %>
              <div class="marketplace-menu-preview">
                <% previewItems.slice(0, 2).forEach((item) => { %>
                  <span><%= item.name %></span>
                <% }) %>
              </div>
            <% } %>
          </div>
        </a>
      <% }) %>
    </div>
  </section>
</section>
</div>

<a href="/cart" class="floating-cart" aria-label="Open cart">
  Cart
</a>

<div id="switch-modal" class="modal">
  <div class="modal-content">
    <h3>Switch Vendor?</h3>
    <p>You already have items from another vendor.</p>
    <p class="warning">Switching will clear your current cart.</p>

    <div class="modal-actions">
      <button id="cancel-switch" class="btn cancel" type="button">Cancel</button>
      <button id="confirm-switch" class="btn confirm" type="button">
        Yes, Switch
      </button>
    </div>
  </div>
</div>

<script>
  const popularButtons = document.querySelectorAll("[data-popular-add]");
  const cartCountEl = document.getElementById("cart-count");
  const cartIcon = document.getElementById("cart-icon");
  const modal = document.getElementById("switch-modal");
  const confirmBtn = document.getElementById("confirm-switch");
  const cancelBtn = document.getElementById("cancel-switch");

  let pendingAction = null;

  const openModal = () => modal?.classList.add("show");
  const closeModal = () => modal?.classList.remove("show");

  function triggerCartBounce() {
    if (!cartIcon) return;

    cartIcon.classList.remove("cart-bounce");
    void cartIcon.offsetWidth;
    cartIcon.classList.add("cart-bounce");
  }

  function updatePopularButton(button, data) {
    if (cartCountEl) {
      cartCountEl.innerText = data.cartCount;
    }

    triggerCartBounce();

    button.innerText = "Added";
    button.disabled = true;

    setTimeout(() => {
      button.innerText = "Add";
      button.disabled = false;
    }, 1200);
  }

  popularButtons.forEach((button) => {
    button.addEventListener("click", async () => {
      const id = button.dataset.id;
      const name = button.dataset.name;
      const price = button.dataset.price;
      const vendorId = button.dataset.vendor;

      const sendRequest = async (forceSwitch = false) => {
        return fetch("/cart/add-ajax", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            id,
            name,
            price,
            qty: 1,
            vendorId,
            forceSwitch,
          }),
        });
      };

      try {
        const response = await sendRequest(false);
        const data = await response.json();

        if (data.switchRequired) {
          pendingAction = async () => {
            const retryResponse = await sendRequest(true);
            const retryData = await retryResponse.json();

            updatePopularButton(button, retryData);
          };

          openModal();
          return;
        }

        updatePopularButton(button, data);
      } catch (error) {
        console.error("Cart error:", error);
      }
    });
  });

  confirmBtn?.addEventListener("click", async () => {
    closeModal();

    if (pendingAction) {
      await pendingAction();
      pendingAction = null;
    }
  });

  cancelBtn?.addEventListener("click", () => {
    closeModal();
    pendingAction = null;
  });

  const vendorTypeFilterChips = document.querySelectorAll("[data-vendor-type-filter]");
  const vendorCards = document.querySelectorAll("#vendor-grid [data-vendor-type]");

  vendorTypeFilterChips.forEach((chip) => {
    chip.addEventListener("click", () => {
      const selectedType = chip.dataset.vendorTypeFilter;

      vendorTypeFilterChips.forEach((otherChip) => {
        otherChip.classList.toggle("vendor-type-filter-active", otherChip === chip);
      });

      vendorCards.forEach((card) => {
        const matches = selectedType === "all" || card.dataset.vendorType === selectedType;
        card.style.display = matches ? "" : "none";
      });
    });
  });
</script>

<%- include("partials/footer") %>
