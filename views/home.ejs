<%- include("partials/header", { bodyClass: "home-sidebar-layout" }) %>

<%
  const safeVendors = vendors || [];
  const safePopularItems = popularItems || [];
  const safeVendorSections = vendorSections || [];
  const sectionMeta = {
    restaurant: { label: "Restaurants", subhead: "Order from local favorites" },
    store: { label: "Grocery & convenience", subhead: "Stock up from nearby stores" },
    street_vendor: { label: "Street vendor", subhead: "Grab a quick bite from the street" }
  };
  const fallbackVendorImages = [
    "/homepage_images/Restaurant_items.avif",
    "/homepage_images/papa-johns-banner.webp",
    "/homepage_images/PizzaInnBanner.jpg",
    "/homepage_images/meat.avif",
    "/homepage_images/greek.avif"
  ];
  const marketplaceCategories = [
    {
      name: "Fresh Produce",
      detail: "Fruits, veggies, and herbs",
      tone: "red",
      icon: '<svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg"><circle cx="24" cy="27" r="13" fill="#ef4444"/><path d="M24 16c0-4 3-6 6-6-1 3-3 5-6 6z" fill="#16a34a"/></svg>'
    },
    {
      name: "Bakery",
      detail: "Bread, pastries, and rolls",
      tone: "orange",
      icon: '<svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg"><path d="M8 30c0-10 7-18 16-18s16 8 16 18c0 3-2 5-5 5H13c-3 0-5-2-5-5z" fill="#d97706"/><path d="M17 18l3 10M24 16l2 12M31 18l-3 10" stroke="#92400e" stroke-width="1.6" stroke-linecap="round" fill="none"/></svg>'
    },
    {
      name: "Dairy & Eggs",
      detail: "Milk, cheese, and eggs",
      tone: "gold",
      icon: '<svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg"><path d="M14 10l10-6 10 6v28a2 2 0 0 1-2 2H16a2 2 0 0 1-2-2z" fill="#3b82f6"/><path d="M14 10h20l3 8H11z" fill="#1d4ed8"/><rect x="11" y="24" width="26" height="6" fill="#ffffff" opacity="0.85"/></svg>'
    },
    {
      name: "Beverages",
      detail: "Water, juice, and soda",
      tone: "green",
      icon: '<svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg"><rect x="22" y="6" width="3.4" height="14" rx="1.6" fill="#0369a1" transform="rotate(12 23.7 13)"/><path d="M13 16h22l-2.5 22a3 3 0 0 1-3 2.7H18.5a3 3 0 0 1-3-2.7z" fill="#0ea5e9"/><path d="M13 16h22" stroke="#0369a1" stroke-width="2"/></svg>'
    },
    {
      name: "Household",
      detail: "Cleaning and home basics",
      tone: "teal",
      icon: '<svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg"><rect x="23" y="5" width="9" height="5" rx="1.5" fill="#6b21a8" transform="rotate(-20 27.5 7.5)"/><rect x="20" y="10" width="8" height="9" rx="1.5" fill="#7e22ce"/><rect x="16" y="18" width="16" height="22" rx="3" fill="#a855f7"/></svg>'
    },
    {
      name: "Snacks",
      detail: "Chips, sweets, and treats",
      tone: "pink",
      icon: '<svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg"><circle cx="24" cy="24" r="15" fill="#d97706"/><circle cx="18" cy="19" r="2" fill="#7c2d12"/><circle cx="28" cy="18" r="2" fill="#7c2d12"/><circle cx="31" cy="27" r="2" fill="#7c2d12"/><circle cx="21" cy="30" r="2" fill="#7c2d12"/><circle cx="24" cy="24" r="1.6" fill="#7c2d12"/></svg>'
    }
  ];
  const filterChips = [
    "Fastest nearby",
    "Offers",
    "Top rated",
    "Under 30 min",
    "Pickup",
    "New on Snack"
  ];
  const vendorBadges = ["Low fees", "Top rated", "Great value", "Fast delivery"];
  const vendorItems = safePopularItems.reduce((groups, item) => {
    const key = String(item.vendor_id);
    groups[key] = groups[key] || [];
    groups[key].push(item);
    return groups;
  }, {});
  const heroVendor = safeVendors[0] || {};
  const heroImage =
    heroVendor.banner_url ||
    safePopularItems[0]?.image_url ||
    "/homepage_images/Restaurant_items.avif";
  const isShopper = !currentUser || !["owner", "admin", "driver"].includes(currentUser.role);
%>

<div class="marketplace-home-layout">
  <%- include("partials/sidebar", { currentPage: "home" }) %>

<section class="marketplace-page" id="marketplace-top">
  <% if (typeof usualOrder !== "undefined" && usualOrder) { %>
    <section class="usual-order-prompt" id="usual-order-prompt" aria-label="Your usual order">
      <div class="usual-order-copy">
        <span class="usual-order-eyebrow">Welcome back</span>
        <h2>Want your usual?</h2>
        <p>
          Your usual from <strong><%= usualOrder.vendor.name %></strong> —
          <%= usualOrder.items.length %> item<%= usualOrder.items.length === 1 ? "" : "s" %>
          · <%= formatCurrency(usualOrder.total) %>
        </p>
        <ul class="usual-order-items">
          <% usualOrder.items.slice(0, 4).forEach((item) => { %>
            <li><%= item.qty %>&times; <%= item.name %></li>
          <% }) %>
          <% if (usualOrder.items.length > 4) { %>
            <li class="usual-order-more">+<%= usualOrder.items.length - 4 %> more</li>
          <% } %>
        </ul>
      </div>
      <div class="usual-order-actions">
        <form method="POST" action="/usual-order/add">
          <button type="submit" class="btn vendor-primary-cta">Yes, add my usual</button>
        </form>
        <button type="button" class="btn vendor-secondary-cta" data-dismiss-usual>No thanks</button>
      </div>
    </section>

    <script>
      (function () {
        var prompt = document.getElementById("usual-order-prompt");
        if (!prompt) return;

        if (sessionStorage.getItem("usualOrderDismissed") === "1") {
          prompt.style.display = "none";
          return;
        }

        var dismissBtn = prompt.querySelector("[data-dismiss-usual]");
        dismissBtn?.addEventListener("click", function () {
          sessionStorage.setItem("usualOrderDismissed", "1");
          prompt.style.display = "none";
        });
      })();
    </script>
  <% } %>

  <section class="marketplace-hero" aria-label="Food delivery marketplace">
    <div class="marketplace-hero-copy">
      <span class="marketplace-kicker">Snack marketplace</span>
      <h1>Food, groceries, and more from vendors near you.</h1>

      <form class="marketplace-search" method="GET" action="/search">
        <label class="sr-only" for="marketplace-search-input">Search vendors</label>
        <span class="marketplace-search-icon" aria-hidden="true">Search</span>
        <input
          id="marketplace-search-input"
          type="text"
          name="search"
          value="<%= searchQuery || "" %>"
          placeholder="Search vendors or items"
          aria-label="Search vendors or items"
        />
        <button type="submit">Find Food</button>
      </form>

      <div class="marketplace-order-controls" aria-label="Order options">
        <button class="marketplace-control-active" type="button">Delivery</button>
        <button type="button">Pickup</button>
        <span>ASAP</span>
      </div>
    </div>

    <a href="<%= heroVendor.id ? `/vendor/${heroVendor.id}/menu` : "#featured-vendors" %>" class="marketplace-hero-card">
      <img src="<%= heroImage %>" alt="<%= heroVendor.name || "Featured vendor food" %>" />
      <div>
        <span>Featured near you</span>
        <strong><%= heroVendor.name || "Local vendor picks" %></strong>
        <small>Explore menus, prices, and fast checkout.</small>
      </div>
    </a>
  </section>

  <section class="marketplace-filter-bar" aria-label="Vendor filters">
    <% filterChips.forEach((chip, index) => { %>
      <a href="#featured-vendors" class="<%= index === 0 ? "marketplace-filter-active" : "" %>">
        <%= chip %>
      </a>
    <% }) %>
  </section>

  <section class="marketplace-deals" id="marketplace-highlights" aria-label="Marketplace highlights">
    <article>
      <span>Featured offer</span>
      <strong>Low delivery fees from KSh <%= deliveryBaseFee %></strong>
      <a href="#featured-vendors">Browse offers</a>
    </article>
    <article>
      <span>Order faster</span>
      <strong>Popular items are ready to add from the home page</strong>
      <a href="#popular-now">See popular picks</a>
    </article>
    <article>
      <span>Local favorites</span>
      <strong><%= safeVendors.length %> vendors available now</strong>
      <a href="#featured-vendors">View vendors</a>
    </article>
  </section>

  <section id="featured-vendors">
    <% safeVendorSections.forEach((section, sectionIndex) => { %>
      <% const meta = sectionMeta[section.value] || { label: section.value, subhead: "" }; %>

      <% if (section.value === "store") { %>
        <section class="marketplace-category-rail" id="marketplace-categories" aria-label="Grocery categories">
          <% marketplaceCategories.forEach((category) => { %>
            <a href="#featured-vendors" class="marketplace-category-card">
              <span class="marketplace-category-art marketplace-category-<%= category.tone %> <%= category.icon ? "marketplace-category-image" : "" %>">
                <%- category.icon || "" %>
              </span>
              <strong><%= category.name %></strong>
              <small><%= category.detail %></small>
            </a>
          <% }) %>
        </section>
      <% } %>

      <section class="marketplace-section marketplace-type-section">
        <div class="marketplace-section-head">
          <div>
            <span><%= meta.label %></span>
            <h2><%= meta.subhead %></h2>
          </div>
          <% if (isShopper) { %><a href="/cart">Open cart</a><% } %>
        </div>

        <% if (section.popularItems.length > 0) { %>
          <div class="marketplace-item-row"<%- sectionIndex === 0 ? ' id="popular-now"' : "" %>>
            <% section.popularItems.forEach((item, index) => { %>
              <article class="marketplace-item-card">
                <a href="/vendor/<%= item.vendor_id %>/menu" class="marketplace-item-image">
                  <% if (item.image_url) { %>
                    <img src="<%= item.image_url %>" alt="<%= item.name %>" loading="lazy" />
                  <% } else { %>
                    <span>Popular pick</span>
                  <% } %>
                </a>

                <div class="marketplace-item-body">
                  <span><%= item.vendor_name %></span>
                  <h3><%= item.name %></h3>
                  <p><%= item.category || "Customer favorite" %></p>
                  <div>
                    <strong><%= formatCurrency(item.price) %></strong>
                    <% if (isShopper) { %>
                      <button
                        type="button"
                        data-popular-add
                        data-id="<%= item.id %>"
                        data-name="<%= item.name %>"
                        data-price="<%= item.price %>"
                        data-vendor="<%= item.vendor_id %>"
                      >
                        Add
                      </button>
                    <% } %>
                  </div>
                </div>
              </article>
            <% }) %>
          </div>
        <% } %>

        <% if (section.vendors.length === 0) { %>
          <p class="home-empty-state">No <%= meta.label.toLowerCase() %> yet.</p>
        <% } else { %>
          <div class="marketplace-vendor-grid">
            <% section.vendors.forEach((vendor, index) => { %>
              <%
                const badge = "Fast delivery";
                const bannerImage = vendor.banner_url || fallbackVendorImages[index % fallbackVendorImages.length];
                const previewItems = vendorItems[String(vendor.id)] || [];
              %>

              <a href="/vendor/<%= vendor.id %>/menu" class="marketplace-vendor-card">
                <div class="marketplace-vendor-media">
                  <img src="<%= bannerImage %>" alt="<%= vendor.name %> food" loading="lazy" />
                  <span class="marketplace-store-badge"><%= badge %></span>
                  <%- include("partials/favoriteButton", { vendorId: vendor.id }) %>
                  <span class="marketplace-vendor-logo">
                    <% if (vendor.logo_url) { %>
                      <img src="<%= vendor.logo_url %>" alt="<%= vendor.name %> logo" loading="lazy" />
                    <% } else { %>
                      <span class="home-logo-fallback"><%= vendor.name.charAt(0).toUpperCase() %></span>
                    <% } %>
                  </span>
                </div>

                <div class="marketplace-vendor-content">
                  <div class="marketplace-vendor-title">
                    <div>
                      <h3><%= vendor.name %></h3>
                      <p><span class="vendor-type-tag"><%= vendor.vendor_type_label %></span> · Delivery from KSh <%= deliveryBaseFee %></p>
                    </div>
                    <%- include("partials/vendorRating", { average: vendor.rating_average, count: vendor.rating_count }) %>
                  </div>

                  <p class="marketplace-vendor-description">
                    <%= vendor.description || "Freshly prepared meals with smooth ordering and quick checkout." %>
                  </p>

                  <% if (previewItems.length > 0) { %>
                    <div class="marketplace-menu-preview">
                      <% previewItems.slice(0, 2).forEach((item) => { %>
                        <span><%= item.name %></span>
                      <% }) %>
                    </div>
                  <% } %>
                </div>
              </a>
            <% }) %>
          </div>
        <% } %>
      </section>
    <% }) %>
  </section>
</section>
</div>

<% if (isShopper) { %>
  <a href="/cart" class="floating-cart" aria-label="Open cart">
    &#128722;
  </a>

  <div id="switch-modal" class="modal">
    <div class="modal-content">
      <h3>Switch Vendor?</h3>
      <p>You already have items from another vendor.</p>
      <p class="warning">Switching will clear your current cart.</p>

      <div class="modal-actions">
        <button id="cancel-switch" class="btn cancel" type="button">Cancel</button>
        <button id="confirm-switch" class="btn confirm" type="button">
          Yes, Switch
        </button>
      </div>
    </div>
  </div>
<% } %>

<script>
  const popularButtons = document.querySelectorAll("[data-popular-add]");
  const cartCountEl = document.getElementById("cart-count");
  const cartIcon = document.getElementById("cart-icon");
  const modal = document.getElementById("switch-modal");
  const confirmBtn = document.getElementById("confirm-switch");
  const cancelBtn = document.getElementById("cancel-switch");

  let pendingAction = null;

  const openModal = () => modal?.classList.add("show");
  const closeModal = () => modal?.classList.remove("show");

  function triggerCartBounce() {
    if (!cartIcon) return;

    cartIcon.classList.remove("cart-bounce");
    void cartIcon.offsetWidth;
    cartIcon.classList.add("cart-bounce");
  }

  function updatePopularButton(button, data) {
    if (cartCountEl) {
      cartCountEl.innerText = data.cartCount;
    }

    triggerCartBounce();
    window.cartDrawer?.refreshIfOpen();

    button.innerText = "Added";
    button.disabled = true;

    setTimeout(() => {
      button.innerText = "Add";
      button.disabled = false;
    }, 1200);
  }

  popularButtons.forEach((button) => {
    button.addEventListener("click", async () => {
      const id = button.dataset.id;
      const name = button.dataset.name;
      const price = button.dataset.price;
      const vendorId = button.dataset.vendor;

      const sendRequest = async (forceSwitch = false) => {
        return fetch("/cart/add-ajax", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            id,
            name,
            price,
            qty: 1,
            vendorId,
            forceSwitch,
          }),
        });
      };

      try {
        const response = await sendRequest(false);
        const data = await response.json();

        if (data.switchRequired) {
          pendingAction = async () => {
            const retryResponse = await sendRequest(true);
            const retryData = await retryResponse.json();

            updatePopularButton(button, retryData);
          };

          openModal();
          return;
        }

        updatePopularButton(button, data);
      } catch (error) {
        console.error("Cart error:", error);
      }
    });
  });

  confirmBtn?.addEventListener("click", async () => {
    closeModal();

    if (pendingAction) {
      await pendingAction();
      pendingAction = null;
    }
  });

  cancelBtn?.addEventListener("click", () => {
    closeModal();
    pendingAction = null;
  });
</script>

<%- include("partials/footer") %>
