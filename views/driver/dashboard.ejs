<%- include("../partials/header", { bodyClass: "home-sidebar-layout" }) %>

<div class="marketplace-home-layout">
  <%- include("../partials/driverSidebar") %>

<section class="driver-dashboard" id="driver-top">
  <div class="driver-hero">
    <div class="driver-hero-copy">
      <span class="feature-eyebrow">Driver workspace</span>
      <h1><%= driver.full_name || "Driver" %></h1>
      <p>
        Accept available orders, move deliveries through each stage, and keep an eye on your tips and completed trips.
      </p>
    </div>

    <div class="driver-hero-stats">
      <div class="driver-stat-card">
        <span>Active journeys</span>
        <strong><%= driverStats.activeJobs %></strong>
      </div>
      <div class="driver-stat-card">
        <span>Available jobs</span>
        <strong><%= driverStats.availableJobs %></strong>
      </div>
      <div class="driver-stat-card">
        <span>Tips earned</span>
        <strong><%= formatCurrency(driverStats.totalTips) %></strong>
      </div>
    </div>
  </div>

  <div class="driver-grid">
    <section class="driver-panel" id="driver-profile">
      <div class="driver-panel-head">
        <div>
          <span class="ops-panel-kicker">Profile</span>
          <h2>Driver profile</h2>
        </div>
        <span class="ops-chip"><%= driver.status %></span>
      </div>

      <div class="driver-profile-list">
        <div class="driver-profile-row">
          <span>Vehicle</span>
          <strong><%= driver.vehicle_type || "Not set" %></strong>
        </div>
        <div class="driver-profile-row">
          <span>Phone</span>
          <strong><%= driver.phone || "Not set" %></strong>
        </div>
        <div class="driver-profile-row">
          <span>License / ID</span>
          <strong><%= driver.license_number || "Not set" %></strong>
        </div>
        <div class="driver-profile-row">
          <span>Current location</span>
          <strong><%= driver.current_location || "Awaiting first route" %></strong>
        </div>
        <div class="driver-profile-row">
          <span>Rating</span>
          <strong><%= Number(driver.rating || 4.8).toFixed(1) %>/5</strong>
        </div>
      </div>
    </section>

    <section class="driver-panel" id="driver-tips">
      <div class="driver-panel-head">
        <div>
          <span class="ops-panel-kicker">Tips</span>
          <h2>Tip tracking</h2>
        </div>
      </div>

      <div class="driver-tip-grid">
        <div class="driver-tip-card">
          <span>Total tips</span>
          <strong><%= formatCurrency(driverStats.totalTips) %></strong>
        </div>
        <div class="driver-tip-card">
          <span>Weekly tips</span>
          <strong><%= formatCurrency(driverStats.weeklyTips) %></strong>
        </div>
        <div class="driver-tip-card">
          <span>Completed jobs</span>
          <strong><%= driverStats.completedJobs %></strong>
        </div>
      </div>
    </section>

    <section class="driver-panel driver-panel-wide" id="driver-available">
      <div class="driver-panel-head">
        <div>
          <span class="ops-panel-kicker">Available orders</span>
          <h2>Pick up a new delivery</h2>
        </div>
      </div>

      <% if (!availableDeliveries.length) { %>
        <p class="ops-empty">No open deliveries right now. Check back in a moment.</p>
      <% } else { %>
        <div class="driver-card-grid">
          <% availableDeliveries.forEach((delivery) => { %>
            <article class="driver-order-card">
              <div class="driver-order-head">
                <div>
                  <strong>#<%= delivery.order_id %></strong>
                  <span><%= delivery.vendor_name %></span>
                </div>
                <strong><%= formatCurrency(delivery.total) %></strong>
              </div>
              <p><strong>Pickup:</strong> <%= delivery.pickup_location || delivery.vendor_name %></p>
              <p>
                <strong>Dropoff:</strong> <%= delivery.dropoff_location || delivery.delivery_address || "Awaiting address" %>
                <% if (delivery.delivery_lat && delivery.delivery_lng) { %>
                  &middot; <a href="https://www.google.com/maps?q=<%= delivery.delivery_lat %>,<%= delivery.delivery_lng %>" target="_blank" rel="noopener">Open in Maps</a>
                <% } %>
              </p>
              <p><strong>Tip:</strong> <%= formatCurrency(delivery.tips) %></p>
              <form action="/driver/deliveries/<%= delivery.id %>/accept" method="POST">
                <button type="submit" class="btn vendor-primary-cta">Accept delivery</button>
              </form>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>

    <section class="driver-panel driver-panel-wide" id="driver-active">
      <div class="driver-panel-head">
        <div>
          <span class="ops-panel-kicker">Journey board</span>
          <h2>Active delivery journey</h2>
        </div>
      </div>

      <% if (!activeDeliveries.length) { %>
        <p class="ops-empty">No active journeys. Accept a delivery to begin.</p>
      <% } else { %>
        <div class="driver-card-grid">
          <% activeDeliveries.forEach((delivery) => { %>
            <article class="driver-order-card driver-order-card-active">
              <div class="driver-order-head">
                <div>
                  <strong>#<%= delivery.order_id %></strong>
                  <span><%= delivery.vendor_name %></span>
                </div>
                <span class="ops-chip"><%= delivery.current_stage %></span>
              </div>

              <div class="driver-journey-steps">
                <span class="driver-step <%= delivery.status === 'Accepted' ? 'driver-step-active' : '' %>">Heading to pickup</span>
                <span class="driver-step <%= delivery.status === 'Picked Up' ? 'driver-step-active' : '' %>">Picked up</span>
                <span class="driver-step <%= delivery.status === 'Out for Delivery' ? 'driver-step-active' : '' %>">On the road</span>
                <span class="driver-step <%= delivery.status === 'Delivered' ? 'driver-step-active' : '' %>">Delivered</span>
              </div>

              <p>
                <strong>Dropoff:</strong> <%= delivery.dropoff_location || delivery.delivery_address || "Awaiting address" %>
                <% if (delivery.delivery_lat && delivery.delivery_lng) { %>
                  &middot; <a href="https://www.google.com/maps?q=<%= delivery.delivery_lat %>,<%= delivery.delivery_lng %>" target="_blank" rel="noopener">Open in Maps</a>
                <% } %>
              </p>
              <p><strong>Customer phone:</strong> <%= delivery.customer_phone || "Not provided" %></p>

              <div class="driver-stage-actions">
                <form action="/driver/deliveries/<%= delivery.id %>/stage" method="POST">
                  <input type="hidden" name="stage" value="picked_up" />
                  <button type="submit" class="btn vendor-secondary-cta">Picked Up</button>
                </form>
                <form action="/driver/deliveries/<%= delivery.id %>/stage" method="POST">
                  <input type="hidden" name="stage" value="out_for_delivery" />
                  <button type="submit" class="btn vendor-secondary-cta">Out for Delivery</button>
                </form>
                <form action="/driver/deliveries/<%= delivery.id %>/stage" method="POST">
                  <input type="hidden" name="stage" value="delivered" />
                  <button type="submit" class="btn vendor-primary-cta">Delivered</button>
                </form>
              </div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>

    <section class="driver-panel driver-panel-wide" id="driver-history">
      <div class="driver-panel-head">
        <div>
          <span class="ops-panel-kicker">History</span>
          <h2>Completed trips</h2>
        </div>
      </div>

      <% if (!completedDeliveries.length) { %>
        <p class="ops-empty">Completed deliveries will appear here once you finish your first trip.</p>
      <% } else { %>
        <div class="ops-orders-table">
          <% completedDeliveries.forEach((delivery) => { %>
            <div class="ops-order-row">
              <div>
                <strong>#<%= delivery.order_id %></strong>
                <span><%= delivery.vendor_name %></span>
              </div>
              <div>
                <span class="ops-order-status">Tip <%= formatCurrency(delivery.tips) %></span>
                <strong><%= delivery.completed_at ? new Date(delivery.completed_at).toLocaleString() : "Completed" %></strong>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </section>
  </div>
</section>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
  const activeOrderIds = <%- JSON.stringify(activeDeliveries.map((d) => d.order_id)) %>;

  if (activeOrderIds.length > 0 && "geolocation" in navigator) {
    const socket = io();
    let lastPingAt = 0;
    const PING_INTERVAL_MS = 15000;

    navigator.geolocation.watchPosition(
      (position) => {
        const now = Date.now();
        if (now - lastPingAt < PING_INTERVAL_MS) return;
        lastPingAt = now;

        const { latitude, longitude } = position.coords;

        activeOrderIds.forEach((orderId) => {
          socket.emit("driverLocationPing", { orderId, lat: latitude, lng: longitude });
        });
      },
      (error) => {
        console.error("Location tracking unavailable:", error.message);
      },
      { enableHighAccuracy: true, maximumAge: 10000 }
    );
  }
</script>

<%- include("../partials/footer") %>
