<%- include("partials/header") %>

<% const isShopper = !currentUser || !["owner", "admin", "driver"].includes(currentUser.role); %>
<% const menuVendorStatus = vendorOpenStatus(vendor); %>
<% const isServiceVendor = vendor.vendor_type === "service_provider"; %>

<section class="menu-page">
  <div class="menu-page-hero">
    <div class="menu-page-copy">
      <span class="feature-eyebrow"><%= isServiceVendor ? "Service listings" : "Delivery menu" %></span>
      <h1><%= vendor.name %></h1>
      <div class="menu-page-rating">
        <%- include("partials/vendorRating", { average: vendor.rating_average, count: vendor.rating_count }) %>
        <span class="vendor-status-pill vendor-status-<%= menuVendorStatus.open ? "open" : "closed" %>">
          <%= menuVendorStatus.label %> · <%= formatVendorHours(vendor) %>
        </span>
      </div>
      <p>
        <%= vendor.description || (isServiceVendor ? "Browse services, pick a time slot, and book in a few taps." : "Explore the menu, refine what you want quickly, and send it straight to your cart.") %>
      </p>

      <div class="menu-page-highlights">
        <% if (isServiceVendor) { %>
          <span class="menu-highlight-pill">Verified pro</span>
          <span class="menu-highlight-pill">Book a time slot</span>
          <span class="menu-highlight-pill">Pay through Snack</span>
        <% } else { %>
          <span class="menu-highlight-pill">Fast prep</span>
          <span class="menu-highlight-pill">Most loved items</span>
          <span class="menu-highlight-pill">Straight to cart</span>
        <% } %>
      </div>

      <div class="menu-page-actions">
        <a href="<%= isServiceVendor ? "/services" : "/" %>" class="btn vendor-secondary-cta">Back to Discovery</a>
        <a href="/cart" class="btn vendor-primary-cta">Open Cart</a>
      </div>
    </div>

    <div class="menu-page-panel <%= vendor.banner_url ? 'menu-page-panel-has-banner' : '' %>">
      <% if (vendor.banner_url) { %>
        <div class="vendor-hero-panel-banner">
          <img
            src="<%= vendor.banner_url %>"
            alt="<%= vendor.name %> banner"
            class="vendor-banner-image"
            loading="lazy"
          />
        </div>
      <% } %>

      <div class="vendor-logo vendor-hero-logo">
        <% if (vendor.logo_url) { %>
          <img src="<%= vendor.logo_url %>" alt="<%= vendor.name %> logo" loading="lazy">
        <% } else { %>
          <span class="home-logo-fallback"><%= vendor.name.charAt(0).toUpperCase() %></span>
        <% } %>
      </div>

      <div class="menu-page-panel-grid">
        <div class="vendor-metric">
          <strong><%= items.length %></strong>
          <span><%= isServiceVendor ? "service" : "item" %><%= items.length === 1 ? "" : "s" %> on this page</span>
        </div>
        <div class="vendor-metric">
          <strong><%= totalPages %></strong>
          <span>page<%= totalPages === 1 ? "" : "s" %> to browse</span>
        </div>
        <% if (isServiceVendor) { %>
          <div class="vendor-metric">
            <strong>On-site</strong>
            <span>at your address</span>
          </div>
        <% } else { %>
          <div class="vendor-metric">
            <strong>KSh <%= deliveryBaseFee %>+</strong>
            <span>delivery</span>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <% if (!menuVendorStatus.open) { %>
    <div class="vendor-closed-banner">
      <strong><%= vendor.name %> is currently closed.</strong>
      <span>Opening hours: <%= formatVendorHours(vendor) %>. You can browse the menu, but ordering resumes when they reopen.</span>
    </div>
  <% } %>

  <section class="menu-filter-card">
    <form id="filterForm" method="GET" action="/vendor/<%= vendor.id %>/menu" class="menu-filter-form">
      <div class="menu-filter-input">
        <label class="sr-only" for="menu-search">Search menu</label>
        <input
          id="menu-search"
          type="text"
          name="search"
          placeholder="<%= isServiceVendor ? 'Search services' : 'Search dishes, combos, or drinks' %>"
          value="<%= searchQuery || '' %>"
        />
      </div>

      <div class="menu-filter-select">
        <label class="sr-only" for="category">Category</label>
        <select id="category" name="category">
          <option value="">All categories</option>
          <option value="Starter" <%= selectedCategory === "Starter" ? "selected" : "" %>>Starter</option>
          <option value="Main" <%= selectedCategory === "Main" ? "selected" : "" %>>Main</option>
          <option value="Dessert" <%= selectedCategory === "Dessert" ? "selected" : "" %>>Dessert</option>
          <option value="Drinks" <%= selectedCategory === "Drinks" ? "selected" : "" %>>Drinks</option>
        </select>
      </div>

      <button type="submit" class="btn vendor-primary-cta"><%= isServiceVendor ? "Refine Services" : "Refine Menu" %></button>
    </form>

    <div class="menu-results-meta">
      <span><%= items.length %> result<%= items.length === 1 ? "" : "s" %></span>
      <span><%= isServiceVendor ? "Ready to book" : "Delivery-ready menu" %></span>
    </div>
  </section>

  <% if (!items || items.length === 0) { %>
    <section class="menu-empty-state">
      <h2>No <%= isServiceVendor ? "services" : "menu items" %> matched that filter.</h2>
      <p>Try a different search or switch back to all categories.</p>
    </section>
  <% } %>

  <div class="menu-grid menu-grid-modern">
    <% items.forEach((item, index) => { %>
      <% const isItemAvailable = item.status === "Available"; %>
      <article class="menu-card modern-menu-card <%= isItemAvailable ? '' : 'menu-card-unavailable' %>">
        <% if (item.image_url) { %>
          <% if (item.image_url.includes("-800.jpg")) { %>
            <% const baseName = item.image_url.replace("-800.jpg", ""); %>
            <picture>
              <source srcset="<%= baseName %>.webp" type="image/webp">
              <img
                src="<%= item.image_url %>"
                srcset="<%= baseName %>-400.jpg 400w,
                        <%= baseName %>-800.jpg 800w,
                        <%= baseName %>-1200.jpg 1200w"
                sizes="(max-width: 760px) 100vw, (max-width: 1080px) 50vw, 33vw"
                alt="<%= item.name %>"
                class="menu-image"
                loading="lazy"
                decoding="async"
                width="400"
                height="300"
              >
            </picture>
          <% } else { %>
            <img
              src="<%= item.image_url %>"
              alt="<%= item.name %>"
              class="menu-image"
              loading="lazy"
              decoding="async"
              width="400"
              height="300"
            >
          <% } %>
        <% } %>

        <div class="menu-content modern-menu-content">
          <div class="modern-menu-head">
            <span class="menu-category"><%= item.category || "Popular" %></span>
            <span class="menu-price"><%= formatCurrency(item.price) %></span>
          </div>

          <h3>
            <%= item.name %>
            <% if (!isItemAvailable) { %>
              <span class="menu-item-status-badge"><%= item.status %></span>
            <% } %>
          </h3>
          <p class="menu-description"><%= item.description || (isServiceVendor ? "Built for fast, easy booking." : "Built for fast delivery decisions.") %></p>

          <% if (isShopper) { %>
            <% if (isItemAvailable && menuVendorStatus.open) { %>
              <div class="add-to-cart-form modern-add-to-cart-form">
                <input
                  type="number"
                  value="1"
                  min="1"
                  class="qty-input"
                  id="qty-<%= item.id %>"
                />

                <button
                  class="btn add-to-cart-btn"
                  data-id="<%= item.id %>"
                  data-name="<%= item.name %>"
                  data-price="<%= item.price %>"
                  data-vendor="<%= vendor.id %>"
                  data-original-label="<%= isServiceVendor ? "Add to Booking" : "Add to Cart" %>"
                >
                  <%= isServiceVendor ? "Add to Booking" : "Add to Cart" %>
                </button>
              </div>
            <% } else { %>
              <button class="btn add-to-cart-btn" type="button" disabled>
                <%= !menuVendorStatus.open ? "Closed" : item.status %>
              </button>
            <% } %>
          <% } %>
        </div>
      </article>
    <% }) %>
  </div>

  <% if (totalPages > 1) { %>
    <div class="pagination modern-pagination">
      <% if (currentPage > 1) { %>
        <a href="/vendor/<%= vendor.id %>/menu?page=<%= currentPage - 1 %>&search=<%= searchQuery || "" %>&category=<%= selectedCategory || "" %>">
          &larr; Previous
        </a>
      <% } %>

      <span>Page <%= currentPage %> of <%= totalPages %></span>

      <% if (currentPage < totalPages) { %>
        <a href="/vendor/<%= vendor.id %>/menu?page=<%= currentPage + 1 %>&search=<%= searchQuery || "" %>&category=<%= selectedCategory || "" %>">
          Next &rarr;
        </a>
      <% } %>
    </div>
  <% } %>
</section>

<% if (isShopper) { %>
  <div id="switch-modal" class="modal">
    <div class="modal-content">
      <h3>Switch Vendor?</h3>
      <p>You already have items from another vendor.</p>
      <p class="warning">Switching will clear your current cart.</p>

      <div class="modal-actions">
        <button id="cancel-switch" class="btn cancel" type="button">Cancel</button>
        <button id="confirm-switch" class="btn confirm" type="button">Yes, Switch</button>
      </div>
    </div>
  </div>
<% } %>

<script>
  const buttons = document.querySelectorAll(".add-to-cart-btn");
  const cartCountEl = document.getElementById("cart-count");
  const cartIcon = document.getElementById("cart-icon");

  const modal = document.getElementById("switch-modal");
  const confirmBtn = document.getElementById("confirm-switch");
  const cancelBtn = document.getElementById("cancel-switch");

  let pendingAction = null;

  const openModal = () => modal?.classList.add("show");
  const closeModal = () => modal?.classList.remove("show");

  function triggerCartBounce() {
    if (!cartIcon) return;
    cartIcon.classList.remove("cart-bounce");
    void cartIcon.offsetWidth;
    cartIcon.classList.add("cart-bounce");
  }

  buttons.forEach(btn => {
    btn.addEventListener("click", async () => {
      const id = btn.dataset.id;
      const name = btn.dataset.name;
      const price = btn.dataset.price;
      const vendorId = btn.dataset.vendor;

      const qtyInput = document.getElementById(`qty-${id}`);
      const qty = parseInt(qtyInput.value, 10) || 1;

      const sendRequest = async (forceSwitch = false) => {
        return fetch("/cart/add-ajax", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            id,
            name,
            price,
            qty,
            vendorId,
            forceSwitch
          })
        });
      };

      try {
        let res = await sendRequest(false);
        let data = await res.json();

        if (!res.ok || data.error) {
          btn.innerText = data.error || "Unavailable";
          btn.disabled = true;
          return;
        }

        if (data.switchRequired) {
          pendingAction = async () => {
            const retryRes = await sendRequest(true);
            const retryData = await retryRes.json();
            updateUI(retryData, btn);
          };

          openModal();
          return;
        }

        updateUI(data, btn);
      } catch (err) {
        console.error("Cart error:", err);
      }
    });
  });

  confirmBtn?.addEventListener("click", async () => {
    closeModal();
    if (pendingAction) {
      await pendingAction();
      pendingAction = null;
    }
  });

  cancelBtn?.addEventListener("click", () => {
    closeModal();
    pendingAction = null;
  });

  function updateUI(data, btn) {
    if (cartCountEl) {
      cartCountEl.innerText = data.cartCount;
    }

    triggerCartBounce();
    window.cartDrawer?.refreshIfOpen();
    window.snackToast?.("Added to your cart");

    btn.innerText = "Added";
    btn.style.background = "#16a34a";
    btn.disabled = true;

    setTimeout(() => {
      btn.innerText = btn.dataset.originalLabel || "Add to Cart";
      btn.style.background = "";
      btn.disabled = false;
    }, 1200);
  }
</script>

<%- include("partials/footer") %>
