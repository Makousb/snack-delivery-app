<%- include("partials/header") %>

<section class="cart-page">
  <div class="cart-page-head">
    <div>
      <span class="feature-eyebrow">Cart and checkout</span>
      <h1>Your order is almost moving.</h1>
      <p>Review items, confirm your delivery details, and complete checkout without breaking momentum.</p>

      <div class="cart-status-pills">
        <span class="cart-status-pill">Live order summary</span>
        <span class="cart-status-pill">Address memory on</span>
      </div>
    </div>

    <a
      href="/vendor/<%= vendorId || 1 %>/menu"
      class="btn vendor-secondary-cta"
    >
      Continue Shopping
    </a>
  </div>

  <% if (!cartItems || cartItems.length === 0) { %>
    <section class="cart-empty-state">
      <h2>Your cart is empty.</h2>
      <p>Jump back into a vendor's menu and start building an order.</p>
      <a
        href="/vendor/<%= vendorId || 1 %>/menu"
        class="btn cart-return-link"
      >
        Back to Menu
      </a>
    </section>
  <% } else { %>
    <div class="cart-layout">
      <div class="cart-items-stack">
        <% cartItems.forEach(item => { %>
          <article class="cart-item-card">
            <div class="cart-item-main">
              <div class="cart-item-copy">
                <span class="menu-category">Vendor <%= vendorId %></span>
                <h3><%= item.name %></h3>
                <p><%= formatCurrency(item.price) %> each</p>
              </div>

              <div class="cart-item-total">
                <%= formatCurrency(item.price * item.qty) %>
              </div>
            </div>

            <div class="cart-item-controls">
              <form method="POST" action="/cart/update" class="qty-form cart-qty-form">
                <input type="hidden" name="vendorId" value="<%= vendorId %>">
                <input type="hidden" name="itemId" value="<%= item.id %>">

                <input
                  type="number"
                  name="qty"
                  value="<%= item.qty %>"
                  min="0"
                  class="qty-input cart-qty-input"
                />

                <button type="submit" class="btn cart-update-btn">
                  Update
                </button>
              </form>

              <form method="POST" action="/cart/update" class="cart-remove-form">
                <input type="hidden" name="vendorId" value="<%= vendorId %>">
                <input type="hidden" name="itemId" value="<%= item.id %>">
                <input type="hidden" name="qty" value="0">

                <button type="submit" class="btn cart-remove-btn">
                  Remove
                </button>
              </form>
            </div>
          </article>
        <% }) %>
      </div>

      <aside class="cart-summary-card" data-cart-summary data-vendor-id="<%= vendorId || "" %>" data-subtotal="<%= total %>" data-fallback-fee="<%= deliveryFee %>">
        <span class="feature-eyebrow">Checkout</span>
        <h2>Ready to place the order?</h2>

        <div class="cart-summary-stats">
          <div class="cart-summary-stat">
            <strong data-eta-window>25-40 min</strong>
            <span>delivery window</span>
          </div>
          <div class="cart-summary-stat">
            <strong>Saved</strong>
            <span>address sync</span>
          </div>
        </div>

        <div class="cart-summary-breakdown">
          <div class="cart-summary-row">
            <span>Subtotal</span>
            <strong><%= formatCurrency(total) %></strong>
          </div>
          <div class="cart-summary-row">
            <span>Delivery <span class="cart-delivery-note" data-delivery-note>(estimated)</span></span>
            <strong data-delivery-fee><%= formatCurrency(deliveryFee) %></strong>
          </div>
        </div>

        <div class="cart-summary-total">
          <span>Total</span>
          <strong data-grand-total><%= formatCurrency(grandTotal) %></strong>
        </div>

        <form method="POST" action="/vendor/<%= vendorId || 1 %>/order" class="checkout-form modern-checkout-form">
          <div class="checkout-field">
            <span class="checkout-fulfillment-label"><strong>How would you like it?</strong></span>
            <div class="fulfillment-options">
              <label class="fulfillment-option">
                <input type="radio" name="fulfillmentType" value="delivery" checked data-fulfillment-input> Delivery
              </label>
              <label class="fulfillment-option">
                <input type="radio" name="fulfillmentType" value="pickup" data-fulfillment-input> Pickup (collect from vendor)
              </label>
            </div>
          </div>

          <div class="checkout-field" data-delivery-only>
            <label for="delivery-address"><strong>Delivery Address:</strong></label>
            <textarea
              id="delivery-address"
              name="deliveryAddress"
              class="checkout-input checkout-textarea"
              placeholder="Enter your delivery address"
              data-checkout-address
            ></textarea>
            <p class="checkout-address-note">
              Snack remembers this address on this browser so repeat orders stay quick.
            </p>

            <button type="button" class="btn vendor-secondary-cta" data-capture-location>
              Use my current location
            </button>
            <p class="checkout-address-note" data-location-status></p>
            <input type="hidden" name="deliveryLat" />
            <input type="hidden" name="deliveryLng" />
          </div>

          <% if (typeof mpesaEnabled !== "undefined" && mpesaEnabled) { %>
            <div class="checkout-field">
              <label for="phone"><strong>Phone Number (for M-Pesa):</strong></label>
              <input
                type="text"
                id="phone"
                name="phone"
                placeholder="254712345678"
                pattern="254[0-9]{9}"
                class="checkout-input"
              />
            </div>
          <% } %>

          <div class="checkout-field">
            <label for="tipAmount"><strong>Driver Tip (KSh, optional):</strong></label>
            <input
              type="number"
              id="tipAmount"
              name="tipAmount"
              min="0"
              step="10"
              placeholder="0"
              class="checkout-input"
            />
          </div>

          <div class="checkout-actions">
            <% if (typeof mpesaEnabled !== "undefined" && mpesaEnabled) { %>
              <button
                type="submit"
                name="paymentMethod"
                value="mpesa"
                class="btn checkout-primary-btn"
              >
                Pay with M-Pesa
              </button>
            <% } %>

            <button
              type="submit"
              name="paymentMethod"
              value="cash"
              class="btn <%= (typeof mpesaEnabled !== "undefined" && mpesaEnabled) ? "checkout-secondary-btn" : "checkout-primary-btn" %>"
            >
              Pay on Delivery
            </button>
          </div>
        </form>
      </aside>
    </div>
  <% } %>
</section>

<script>
  (function () {
    const summary = document.querySelector("[data-cart-summary]");
    if (!summary) return;

    const vendorId = summary.dataset.vendorId;
    const subtotal = Number(summary.dataset.subtotal) || 0;
    const feeEl = summary.querySelector("[data-delivery-fee]");
    const totalEl = summary.querySelector("[data-grand-total]");
    const etaEl = summary.querySelector("[data-eta-window]");
    const noteEl = summary.querySelector("[data-delivery-note]");

    const fallbackFee = Number(summary.dataset.fallbackFee) || 0;
    const deliveryOnly = document.querySelectorAll("[data-delivery-only]");

    let quote = { fee: fallbackFee, etaMin: 25, etaMax: 40, hasCoords: false, distanceKm: null };
    let pickup = false;

    const money = (n) =>
      "KSh " + Number(n).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });

    const render = () => {
      const fee = pickup ? 0 : quote.fee;
      if (feeEl) feeEl.textContent = money(fee);
      if (totalEl) totalEl.textContent = money(subtotal + fee);
      if (etaEl) etaEl.textContent = pickup ? "Ready ~15 min" : quote.etaMin + "-" + quote.etaMax + " min";
      if (noteEl) {
        noteEl.textContent = pickup
          ? "(pickup)"
          : quote.hasCoords
            ? "(" + quote.distanceKm + " km away)"
            : "(estimated)";
      }
    };

    // Fired by address-memory.js whenever delivery coordinates change (GPS or
    // Places autocomplete). Re-price the trip from the vendor.
    document.querySelector(".checkout-form")?.addEventListener("snack:delivery-coords", async (event) => {
      if (!vendorId) return;
      const { lat, lng } = event.detail || {};

      try {
        const params = new URLSearchParams();
        if (lat != null && lng != null) {
          params.set("lat", lat);
          params.set("lng", lng);
        }
        const res = await fetch("/vendor/" + encodeURIComponent(vendorId) + "/delivery-estimate?" + params.toString());
        if (!res.ok) return;
        quote = await res.json();
        render();
      } catch (_) {
        // Leave the current estimate in place if the quote request fails.
      }
    });

    // Delivery vs pickup toggle: pickup zeroes the fee and hides the address.
    document.querySelectorAll("[data-fulfillment-input]").forEach((input) => {
      input.addEventListener("change", () => {
        pickup = document.querySelector("[data-fulfillment-input]:checked")?.value === "pickup";
        deliveryOnly.forEach((el) => { el.hidden = pickup; });
        render();
      });
    });

    render();
  })();
</script>

<%- include("partials/footer") %>
