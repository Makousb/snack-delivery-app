<%- include("partials/header") %>

<section class="order-page">
  <div class="order-page-hero">
    <span class="feature-eyebrow">Order confirmed</span>
    <h1>Your order is in motion.</h1>
    <p>We’ll keep this page updated while the kitchen and delivery flow progress.</p>

    <div class="order-status-pill">
      <span>Current status</span>
      <strong id="order-status"><%= order.status %></strong>
    </div>

    <div class="order-status-pill" id="driver-tracking-pill" style="display: none;">
      <span>Driver</span>
      <strong id="driver-tracking-text">On the way</strong>
    </div>

    <% if (order.payment_method === "mpesa" && order.status === "Pending Payment") { %>
      <form action="/orders/<%= order.id %>/confirm-payment" method="POST" class="auth-form-card mpesa-confirm-form">
        <p>
          Already paid but the status above hasn't updated? Enter the M-Pesa
          confirmation code from your payment SMS and we'll verify it shortly.
        </p>
        <div>
          <label for="mpesaCode">M-Pesa confirmation code</label>
          <input type="text" id="mpesaCode" name="mpesaCode" placeholder="e.g. QGH7XXXXX" />
        </div>
        <button type="submit">Submit code</button>
      </form>
    <% } %>
  </div>

  <div class="order-page-layout">
    <section class="order-card order-items-card">
      <div class="order-card-head">
        <h2>Order details</h2>
        <span class="menu-category"><%= order.vendor_name %></span>
      </div>

      <div class="order-item-list">
        <% items.forEach(item => { %>
          <article class="order-item-row">
            <div>
              <h3><%= item.name %></h3>
              <p><%= item.quantity %> x <%= formatCurrency(item.price) %></p>
            </div>
            <strong><%= formatCurrency(item.price * item.quantity) %></strong>
          </article>
        <% }) %>
      </div>
    </section>

    <aside class="order-card order-summary-card">
      <span class="feature-eyebrow">Summary</span>
      <h2>Everything looks good.</h2>

      <div class="cart-summary-breakdown">
        <div class="cart-summary-row">
          <span>Subtotal</span>
          <strong><%= formatCurrency(order.total) %></strong>
        </div>
        <% if (Number(order.discount) > 0) { %>
          <div class="cart-summary-row cart-summary-discount">
            <span>Discount<% if (order.promo_code) { %> (<%= order.promo_code %>)<% } %></span>
            <strong>-<%= formatCurrency(order.discount) %></strong>
          </div>
        <% } %>
        <div class="cart-summary-row">
          <span><%= order.fulfillment_type === "pickup" ? "Pickup" : "Delivery" %></span>
          <strong><%= formatCurrency(order.delivery_fee || 0) %></strong>
        </div>
        <% if (Number(order.tip) > 0) { %>
          <div class="cart-summary-row">
            <span>Driver tip</span>
            <strong><%= formatCurrency(order.tip) %></strong>
          </div>
        <% } %>
      </div>

      <div class="cart-summary-total">
        <span>Total</span>
        <strong><%= formatCurrency(Number(order.total) - Number(order.discount || 0) + Number(order.delivery_fee || 0) + Number(order.tip || 0)) %></strong>
      </div>

      <div class="order-summary-meta">
        <span>Order #<%= order.id %></span>
        <span><%= order.vendor_name %></span>
        <span><%= order.fulfillment_type === "pickup" ? "Pickup — collect from vendor" : "Delivery" %></span>
      </div>

      <div class="order-summary-actions">
        <a href="/vendor/<%= order.vendor_id %>/menu" class="btn vendor-primary-cta">
          Back to Menu
        </a>
        <a href="/orders" class="btn vendor-secondary-cta">
          View Orders
        </a>
      </div>
    </aside>
  </div>
</section>

<script src="/socket.io/socket.io.js"></script>
<script>
  const socket = io();
  const orderId = "<%= order.id %>";
  const deliveryLat = <%- order.delivery_lat != null ? order.delivery_lat : "null" %>;
  const deliveryLng = <%- order.delivery_lng != null ? order.delivery_lng : "null" %>;

  socket.emit("joinOrderTracking", orderId);

  socket.on("orderUpdated", (data) => {
    if (String(data.orderId) === orderId) {
      const statusEl = document.getElementById("order-status");
      statusEl.innerText = data.status;
      statusEl.style.transition = "color 0.25s ease";
      statusEl.style.color = "#bbf7d0";

      setTimeout(() => {
        statusEl.style.color = "";
      }, 500);
    }
  });

  function haversineKm(lat1, lng1, lat2, lng2) {
    const toRad = (deg) => (deg * Math.PI) / 180;
    const earthRadiusKm = 6371;
    const dLat = toRad(lat2 - lat1);
    const dLng = toRad(lng2 - lng1);
    const a =
      Math.sin(dLat / 2) ** 2 +
      Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLng / 2) ** 2;
    return earthRadiusKm * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  }

  socket.on("driverLocationUpdate", ({ lat, lng }) => {
    const pill = document.getElementById("driver-tracking-pill");
    const text = document.getElementById("driver-tracking-text");

    pill.style.display = "flex";

    if (deliveryLat != null && deliveryLng != null) {
      const distanceKm = haversineKm(lat, lng, deliveryLat, deliveryLng);
      // Straight-line distance, not a routed time estimate -- there's no
      // traffic/routing data here to honestly back a "X min" figure.
      text.innerText = `~${distanceKm.toFixed(1)} km away (straight-line)`;
    } else {
      text.innerText = "Your driver is on the way";
    }
  });
</script>

<%- include("partials/footer") %>
