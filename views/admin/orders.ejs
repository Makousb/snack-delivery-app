<%- include("../partials/header", { bodyClass: "home-sidebar-layout" }) %>

<div class="marketplace-home-layout">
  <%- include("../partials/adminSidebar", { currentPage: "orders" }) %>

<div class="container admin-orders-page">
  <div class="ops-panel-head admin-orders-head">
    <div>
      <span class="ops-panel-kicker">Live queue</span>
      <h1>Incoming Orders</h1>
    </div>
    <span class="ops-chip"><%= orders.length %> order<%= orders.length === 1 ? "" : "s" %> total</span>
  </div>

  <% if (orders.length === 0) { %>
    <p id="no-orders" class="ops-empty">No orders yet. New checkouts appear here in real time.</p>
  <% } %>

  <div class="admin-orders-card">
    <table class="admin-orders-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>Type</th>
          <th>Total</th>
          <th>Status</th>
          <th>M-Pesa Code</th>
          <th>Address</th>
          <th>Created</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody id="orders-table-body">
        <% orders.forEach(order => { %>
          <% const rowIsPickup = order.fulfillment_type === "pickup"; %>
          <tr id="order-<%= order.id %>">
            <td><strong>#<%= order.id %></strong></td>
            <td>
              <span class="fulfillment-chip <%= rowIsPickup ? "fulfillment-chip-pickup" : "" %>">
                <%= rowIsPickup ? "Pickup" : "Delivery" %>
              </span>
            </td>
            <td><%= formatCurrency(order.total) %></td>
            <td><span class="status admin-status-pill"><%= order.status %></span></td>
            <td><%= order.mpesa_manual_code || "—" %></td>
            <td>
              <% if (rowIsPickup) { %>
                Collect at counter
              <% } else { %>
                <%= order.delivery_address || "—" %>
                <% if (order.delivery_lat && order.delivery_lng) { %>
                  <a href="https://www.google.com/maps?q=<%= order.delivery_lat %>,<%= order.delivery_lng %>" target="_blank" rel="noopener">Map</a>
                <% } %>
              <% } %>
            </td>
            <td>
              <%= order.created_at.toLocaleString() %>
              <% if (order.scheduled_for) { %>
                <div class="admin-scheduled-note">For: <%= formatSlotLabel(order.scheduled_for) %></div>
              <% } %>
            </td>
            <td>
              <form method="POST" action="/admin/order/<%= order.id %>/status" class="admin-status-form">
                <select name="status">
                  <option <%= order.status === "Pending Payment" ? "selected" : "" %>>Pending Payment</option>
                  <option <%= order.status === "Payment Pending Verification" ? "selected" : "" %>>Payment Pending Verification</option>
                  <option <%= order.status === "Paid" ? "selected" : "" %>>Paid</option>
                  <option <%= order.status === "Cash Pending" ? "selected" : "" %>>Cash Pending</option>
                  <option <%= order.status === "Preparing" ? "selected" : "" %>>Preparing</option>
                  <% if (rowIsPickup) { %>
                    <option <%= order.status === "Ready for Pickup" ? "selected" : "" %>>Ready for Pickup</option>
                  <% } else { %>
                    <option <%= order.status === "Driver Assigned" ? "selected" : "" %>>Driver Assigned</option>
                    <option <%= order.status === "Out for Delivery" ? "selected" : "" %>>Out for Delivery</option>
                  <% } %>
                  <option <%= order.status === "Completed" ? "selected" : "" %>>Completed</option>
                </select>
                <button type="submit">Update</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
</div>

<script src="/socket.io/socket.io.js"></script>
<script>
  const socket = io();
  const vendorId = "<%= vendorId %>";

  // Join vendor room
  socket.emit("joinVendor", vendorId);

  // Apply colors to existing rows
  document.querySelectorAll(".status").forEach(el => {
    el.setAttribute("data-status", el.innerText);
  });

  // Listen for new orders
  socket.on("newOrder", (order) => {
    const tableBody = document.getElementById("orders-table-body");
    const noOrdersText = document.getElementById("no-orders");

    if (noOrdersText) {
      noOrdersText.remove();
    }

    const isPickup = order.fulfillmentType === "pickup";

    const statusOptions = [
      "Pending Payment",
      "Payment Pending Verification",
      "Paid",
      "Cash Pending",
      "Preparing",
      ...(isPickup ? ["Ready for Pickup"] : ["Driver Assigned", "Out for Delivery"]),
      "Completed"
    ]
      .map((status) => `<option ${order.status === status ? "selected" : ""}>${status}</option>`)
      .join("");

    const row = `
      <tr id="order-${order.orderId}">
        <td><strong>#${order.orderId}</strong></td>
        <td><span class="fulfillment-chip ${isPickup ? "fulfillment-chip-pickup" : ""}">${isPickup ? "Pickup" : "Delivery"}</span></td>
        <td>KSh ${Number(order.total).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</td>
        <td><span class="status admin-status-pill" data-status="${order.status}">${order.status}</span></td>
        <td>—</td>
        <td>
          ${isPickup
            ? "Collect at counter"
            : `${order.deliveryAddress || "—"}
               ${order.deliveryLat && order.deliveryLng ? `<a href="https://www.google.com/maps?q=${order.deliveryLat},${order.deliveryLng}" target="_blank" rel="noopener">Map</a>` : ""}`}
        </td>
        <td>Just now${order.scheduledFor ? `<div class="admin-scheduled-note">For: ${new Date(order.scheduledFor).toLocaleString()}</div>` : ""}</td>
        <td>
          <form method="POST" action="/admin/order/${order.orderId}/status" class="admin-status-form">
            <select name="status">${statusOptions}</select>
            <button type="submit">Update</button>
          </form>
        </td>
      </tr>
    `;

    tableBody.insertAdjacentHTML("afterbegin", row);
    window.snackToast?.("New order #" + order.orderId + " just arrived");
  });

  socket.on("orderUpdated", (data) => {
    const row = document.getElementById(`order-${data.orderId}`);
    if (row) {
      const statusCell = row.querySelector(".status");
      statusCell.innerText = data.status;
      statusCell.setAttribute("data-status", data.status);
    }
  });
</script>

<%- include("../partials/footer") %>
