<%- include("../partials/header", { bodyClass: "home-sidebar-layout" }) %>

<div class="marketplace-home-layout">
  <%- include("../partials/adminSidebar", { currentPage: "profile" }) %>

<%
  const safeVendor = vendor || {};
  const safeVendorTypes = vendorTypes || [];
  const businessName = safeVendor.name || "Business";
  const logoUrl = safeVendor.logo_url || "";
  const bannerUrl = safeVendor.banner_url || "";
%>

<section class="business-profile-shell">
  <div class="business-profile-hero">
    <div>
      <span class="feature-eyebrow">Business profile</span>
      <h1><%= businessName %></h1>
      <p><%= safeVendor.description || "Update the public details customers see before they order." %></p>
      <div class="ops-hero-actions">
        <a href="/admin" class="btn vendor-secondary-cta">Back to Business Hub</a>
        <a href="/vendor/<%= safeVendor.id %>/menu" class="btn vendor-primary-cta">View Public Menu</a>
      </div>
    </div>

    <div class="business-profile-preview" aria-label="Current business profile preview">
      <div class="business-profile-banner">
        <% if (bannerUrl) { %>
          <img src="<%= bannerUrl %>" alt="<%= businessName %> banner" loading="lazy" />
        <% } else { %>
          <span>No banner</span>
        <% } %>
      </div>

      <div class="business-profile-preview-body">
        <div class="business-profile-logo">
          <% if (logoUrl) { %>
            <img src="<%= logoUrl %>" alt="<%= businessName %> logo" loading="lazy" />
          <% } else { %>
            <span><%= businessName.charAt(0).toUpperCase() %></span>
          <% } %>
        </div>
        <div>
          <strong><%= businessName %></strong>
          <span><%= accountEmail %></span>
        </div>
      </div>
    </div>
  </div>

  <form
    action="/admin/profile"
    method="POST"
    enctype="multipart/form-data"
    class="business-profile-form auth-form-card"
  >
    <div>
      <label for="vendorType">Business Type</label>
      <select id="vendorType" name="vendorType" data-vendor-type-select>
        <% safeVendorTypes.forEach((type) => { %>
          <option value="<%= type.value %>" <%= safeVendor.vendor_type === type.value ? "selected" : "" %>><%= type.label %></option>
        <% }) %>
      </select>
    </div>

    <div data-service-category-field style="<%= safeVendor.vendor_type === "service_provider" ? "" : "display: none;" %>">
      <label for="serviceCategory">Service category</label>
      <input
        type="text"
        id="serviceCategory"
        name="serviceCategory"
        list="serviceCategorySuggestions"
        placeholder="e.g. Plumbing"
        value="<%= safeVendor.service_category || "" %>"
      />
      <datalist id="serviceCategorySuggestions">
        <% (typeof serviceCategorySuggestions !== "undefined" ? serviceCategorySuggestions : []).forEach((category) => { %>
          <option value="<%= category %>"></option>
        <% }) %>
      </datalist>
    </div>

    <div class="auth-grid">
      <div>
        <label for="businessName">Business name</label>
        <input
          type="text"
          id="businessName"
          name="businessName"
          value="<%= businessName %>"
          required
        />
      </div>

      <div>
        <label for="email">Account email</label>
        <input
          type="email"
          id="email"
          name="email"
          value="<%= accountEmail %>"
          required
        />
      </div>
    </div>

    <div>
      <label for="businessDescription">Business description</label>
      <textarea
        id="businessDescription"
        name="businessDescription"
        rows="5"
      ><%= safeVendor.description || "" %></textarea>
    </div>

    <div>
      <label for="pickupInstructions">Pickup instructions</label>
      <textarea
        id="pickupInstructions"
        name="pickupInstructions"
        rows="3"
        maxlength="500"
        placeholder="e.g. Use the side entrance on Moi Avenue and quote your order number at the counter."
      ><%= safeVendor.pickup_instructions || "" %></textarea>
      <p class="checkout-address-note">
        Shown to customers who choose pickup — at checkout and on their order confirmation.
      </p>
    </div>

    <div class="auth-grid">
      <div>
        <label for="openingTime">Opening time</label>
        <input
          type="time"
          id="openingTime"
          name="openingTime"
          value="<%= safeVendor.opening_time ? String(safeVendor.opening_time).slice(0, 5) : "" %>"
        />
      </div>
      <div>
        <label for="closingTime">Closing time</label>
        <input
          type="time"
          id="closingTime"
          name="closingTime"
          value="<%= safeVendor.closing_time ? String(safeVendor.closing_time).slice(0, 5) : "" %>"
        />
      </div>
    </div>
    <p class="checkout-address-note">Leave both blank to stay open 24/7. Customers can't order while you're closed.</p>

    <div class="business-profile-assets">
      <div class="business-profile-upload">
        <label for="businessLogo">Logo</label>

        <div class="business-profile-image business-profile-image-logo" data-current-image="businessLogo">
          <% if (logoUrl) { %>
            <img src="<%= logoUrl %>" alt="Current logo" loading="lazy" />
          <% } else { %>
            <span><%= businessName.charAt(0).toUpperCase() %></span>
          <% } %>
        </div>

        <img
          class="business-profile-image-preview business-profile-image-logo is-hidden"
          alt="Selected logo preview"
          data-image-preview="businessLogo"
        />

        <input
          type="file"
          id="businessLogo"
          name="businessLogo"
          accept="image/*"
          data-file-input="businessLogo"
        />
      </div>

      <div class="business-profile-upload">
        <label for="businessBanner">Banner</label>

        <div class="business-profile-image business-profile-image-banner" data-current-image="businessBanner">
          <% if (bannerUrl) { %>
            <img src="<%= bannerUrl %>" alt="Current banner" loading="lazy" />
          <% } else { %>
            <span>No banner</span>
          <% } %>
        </div>

        <img
          class="business-profile-image-preview business-profile-image-banner is-hidden"
          alt="Selected banner preview"
          data-image-preview="businessBanner"
        />

        <input
          type="file"
          id="businessBanner"
          name="businessBanner"
          accept="image/*"
          data-file-input="businessBanner"
        />
      </div>
    </div>

    <div class="business-profile-actions">
      <button type="submit" class="btn vendor-primary-cta">Save Profile</button>
      <a href="/admin" class="btn vendor-secondary-cta">Cancel</a>
    </div>
  </form>
</section>
</div>

<script>
  const vendorTypeSelect = document.querySelector("[data-vendor-type-select]");
  const serviceCategoryField = document.querySelector("[data-service-category-field]");

  vendorTypeSelect?.addEventListener("change", () => {
    if (!serviceCategoryField) return;
    serviceCategoryField.style.display = vendorTypeSelect.value === "service_provider" ? "" : "none";
  });

  document.querySelectorAll("[data-file-input]").forEach((input) => {
    input.addEventListener("change", () => {
      const key = input.dataset.fileInput;
      const file = input.files[0];
      const preview = document.querySelector(`[data-image-preview="${key}"]`);
      const current = document.querySelector(`[data-current-image="${key}"]`);

      if (!preview || !current) return;

      if (!file) {
        preview.classList.add("is-hidden");
        preview.removeAttribute("src");
        current.classList.remove("is-hidden");
        return;
      }

      preview.src = URL.createObjectURL(file);
      preview.classList.remove("is-hidden");
      current.classList.add("is-hidden");
    });
  });
</script>

<%- include("../partials/footer") %>
