<%- include("../partials/header") %>

<%
  const safeDashboard = dashboard || {};
  const safeOrders = orders || [];
  const safeMenuItems = menuItems || [];
  const safeVendor = vendor || {};
  const recentOrders = safeOrders.slice(0, 6);
  const canManage =
    typeof currentUser !== "undefined" &&
    currentUser &&
    ["owner", "admin"].includes(currentUser.role);
%>

<section class="ops-dashboard">
  <div class="ops-hero">
    <div class="ops-hero-copy">
      <span class="feature-eyebrow">Operations overview</span>
      <h1>Delivery command center</h1>
      <p>
        Monitor inventory, order flow, driver movement, service quality, and revenue from one dashboard built for busy vendor teams.
      </p>

      <div class="ops-hero-actions">
        <% if (canManage) { %>
          <a href="/admin/menu/new" class="btn vendor-primary-cta">Add Menu Item</a>
          <a href="/admin/vendor/<%= vendorId %>/orders" class="btn vendor-secondary-cta">Open Orders</a>
          <a href="/admin/profile" class="btn vendor-secondary-cta">Edit Business Profile</a>
          <a href="/admin/messages" class="btn vendor-secondary-cta">View Messages</a>
        <% } else { %>
          <a href="/auth/login" class="btn vendor-primary-cta">Login to Manage</a>
          <span class="ops-chip">Preview mode</span>
        <% } %>
      </div>
    </div>

    <div class="ops-hero-summary">
      <div class="ops-summary-tile">
        <span class="ops-summary-label">Business</span>
        <strong><%= safeVendor.name || "Vendor" %></strong>
      </div>
      <div class="ops-summary-tile">
        <span class="ops-summary-label">Active orders</span>
        <strong><%= safeDashboard.activeOrdersCount || 0 %></strong>
      </div>
      <div class="ops-summary-tile">
        <span class="ops-summary-label">Today's revenue</span>
        <strong><%= formatCurrency(safeDashboard.revenueToday) %></strong>
      </div>
      <div class="ops-summary-tile">
        <span class="ops-summary-label">On-time rate</span>
        <strong><%= safeDashboard.deliveryRate || 0 %>%</strong>
      </div>
    </div>
  </div>

  <div class="ops-kpi-grid">
    <article class="ops-kpi-card">
      <span class="ops-kpi-label">Inventory</span>
      <strong><%= safeDashboard.totalItems || safeMenuItems.length %></strong>
      <p><%= safeDashboard.availableItems || 0 %> available, <%= safeDashboard.lowStockItems || 0 %> need attention</p>
    </article>

    <article class="ops-kpi-card">
      <span class="ops-kpi-label">Avg. service time</span>
      <strong><%= safeDashboard.averageServiceTime || "No data yet" %></strong>
      <p>Time from accepted delivery to handoff</p>
    </article>

    <article class="ops-kpi-card">
      <span class="ops-kpi-label">Weekly revenue</span>
      <strong><%= formatCurrency(safeDashboard.revenueWeek) %></strong>
      <p>Average order value <%= formatCurrency(safeDashboard.averageOrderValue) %></p>
    </article>
  </div>

  <div class="ops-main-grid">
    <section class="ops-panel">
      <div class="ops-panel-head">
        <div>
          <span class="ops-panel-kicker">Inventory</span>
          <h2>Inventory and order health</h2>
        </div>
        <span class="ops-chip"><%= safeDashboard.inventoryHealth || 0 %>% in stock</span>
      </div>

      <div class="ops-health-grid">
        <div class="ops-health-card">
          <span>Available items</span>
          <strong><%= safeDashboard.availableItems || 0 %></strong>
        </div>
        <div class="ops-health-card">
          <span>Sold out</span>
          <strong><%= safeDashboard.soldOutItems || 0 %></strong>
        </div>
        <div class="ops-health-card">
          <span>Seasonal</span>
          <strong><%= safeDashboard.seasonalItems || 0 %></strong>
        </div>
        <div class="ops-health-card">
          <span>Average menu price</span>
          <strong><%= formatCurrency(safeDashboard.averagePrice) %></strong>
        </div>
      </div>

      <div class="ops-status-breakdown">
        <div class="ops-status-row">
          <span>Pending payment</span>
          <div class="ops-status-bar"><span style="width:<%= Math.max(12, (safeDashboard.orderStatusBreakdown?.pendingPayment || 0) * 18) %>px"></span></div>
          <strong><%= safeDashboard.orderStatusBreakdown?.pendingPayment || 0 %></strong>
        </div>
        <div class="ops-status-row">
          <span>Cash pending</span>
          <div class="ops-status-bar"><span style="width:<%= Math.max(12, (safeDashboard.orderStatusBreakdown?.cashPending || 0) * 18) %>px"></span></div>
          <strong><%= safeDashboard.orderStatusBreakdown?.cashPending || 0 %></strong>
        </div>
        <div class="ops-status-row">
          <span>Paid</span>
          <div class="ops-status-bar"><span style="width:<%= Math.max(12, (safeDashboard.orderStatusBreakdown?.paid || 0) * 18) %>px"></span></div>
          <strong><%= safeDashboard.orderStatusBreakdown?.paid || 0 %></strong>
        </div>
        <div class="ops-status-row">
          <span>Preparing</span>
          <div class="ops-status-bar"><span style="width:<%= Math.max(12, (safeDashboard.orderStatusBreakdown?.preparing || 0) * 18) %>px"></span></div>
          <strong><%= safeDashboard.orderStatusBreakdown?.preparing || 0 %></strong>
        </div>
        <div class="ops-status-row">
          <span>Completed</span>
          <div class="ops-status-bar"><span style="width:<%= Math.max(12, (safeDashboard.orderStatusBreakdown?.completed || 0) * 18) %>px"></span></div>
          <strong><%= safeDashboard.orderStatusBreakdown?.completed || 0 %></strong>
        </div>
      </div>
    </section>

    <section class="ops-panel">
      <div class="ops-panel-head">
        <div>
          <span class="ops-panel-kicker">Dispatch</span>
          <h2>Driver status and locations</h2>
        </div>
        <span class="ops-chip"><%= (safeDashboard.driverStatuses || []).length %> drivers live</span>
      </div>

      <div class="ops-driver-list">
        <% if ((safeDashboard.driverStatuses || []).length === 0) { %>
          <p class="ops-empty">No drivers active right now.</p>
        <% } %>

        <% (safeDashboard.driverStatuses || []).forEach((driver) => { %>
          <div class="ops-driver-row">
            <div>
              <strong><%= driver.name %></strong>
              <span><%= driver.location %></span>
            </div>
            <div class="ops-driver-meta">
              <span class="ops-driver-state"><%= driver.status %></span>
              <strong><%= driver.activeJobs %> active</strong>
            </div>
          </div>
        <% }) %>
      </div>
    </section>

    <section class="ops-panel">
      <div class="ops-panel-head">
        <div>
          <span class="ops-panel-kicker">Performance</span>
          <h2>Service quality scorecard</h2>
        </div>
      </div>

      <div class="ops-score-list">
        <div class="ops-score-row">
          <span>On-time delivery rate</span>
          <strong><%= safeDashboard.deliveryRate || 0 %>%</strong>
        </div>
        <div class="ops-score-row">
          <span>Average service time</span>
          <strong><%= safeDashboard.averageServiceTime || "No data yet" %></strong>
        </div>
      </div>
    </section>

    <section class="ops-panel">
      <div class="ops-panel-head">
        <div>
          <span class="ops-panel-kicker">Orders</span>
          <h2>Recent active orders map</h2>
        </div>
        <span class="ops-chip"><%= safeDashboard.totalOrders || 0 %> total orders</span>
      </div>

      <% if (recentOrders.length === 0) { %>
        <p class="ops-empty">No orders yet. As new checkouts arrive, they will appear here for quick action.</p>
      <% } else { %>
        <div class="ops-orders-table">
          <% recentOrders.forEach((order) => { %>
            <div class="ops-order-row">
              <div>
                <strong>#<%= order.id %></strong>
                <span><%= new Date(order.created_at).toLocaleString() %></span>
              </div>
              <div>
                <span class="ops-order-status"><%= order.status %></span>
                <strong><%= formatCurrency(order.total) %></strong>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </section>
  </div>

  <div class="ops-section-heading">
    <span class="feature-eyebrow">Analytics</span>
    <h2>Sales and operations insights</h2>
  </div>

  <div class="ops-analytics-grid">
    <section class="ops-panel">
      <div class="ops-panel-head">
        <div>
          <span class="ops-panel-kicker">Sales</span>
          <h2>Top sellers this week</h2>
        </div>
        <span class="ops-chip">Last 7 days</span>
      </div>

      <% if (!safeDashboard.topSellers || safeDashboard.topSellers.length === 0) { %>
        <p class="ops-empty">No items sold in the last 7 days yet.</p>
      <% } else { %>
        <ol class="ops-top-sellers">
          <% safeDashboard.topSellers.forEach((item, index) => { %>
            <li class="ops-top-seller-row">
              <span class="ops-top-seller-rank"><%= index + 1 %></span>
              <div class="ops-top-seller-copy">
                <strong><%= item.name %></strong>
                <span><%= item.category %></span>
              </div>
              <div class="ops-top-seller-meta">
                <strong><%= item.units %> sold</strong>
                <span><%= formatCurrency(item.revenue) %></span>
              </div>
            </li>
          <% }) %>
        </ol>
      <% } %>
    </section>

    <section class="ops-panel">
      <div class="ops-panel-head">
        <div>
          <span class="ops-panel-kicker">Revenue</span>
          <h2>Revenue trend</h2>
        </div>
        <span class="ops-chip"><%= formatCurrency(safeDashboard.revenueTrend?.monthTotal) %> / 30 days</span>
      </div>

      <% const trend = safeDashboard.revenueTrend || { days: [], max: 1 }; %>
      <div class="ops-trend-chart">
        <% trend.days.forEach((day) => { %>
          <div class="ops-trend-col">
            <div class="ops-trend-bar-track">
              <span
                class="ops-trend-bar"
                style="height: <%= Math.round((day.total / trend.max) * 100) %>%"
                title="<%= formatCurrency(day.total) %>"
              ></span>
            </div>
            <span class="ops-trend-label"><%= day.label %></span>
          </div>
        <% }) %>
      </div>
      <div class="ops-trend-footer">
        <span>Last 7 days</span>
        <strong><%= formatCurrency(trend.days.reduce((sum, day) => sum + day.total, 0)) %></strong>
      </div>
    </section>

    <section class="ops-panel">
      <div class="ops-panel-head">
        <div>
          <span class="ops-panel-kicker">Fulfillment</span>
          <h2>Delivery timing</h2>
        </div>
        <span class="ops-chip"><%= safeDashboard.fulfillment?.fulfilledCount || 0 %> completed</span>
      </div>

      <% const fulfillment = safeDashboard.fulfillment || {}; %>
      <% if (!fulfillment.fulfilledCount) { %>
        <p class="ops-empty">No completed deliveries yet. Timing appears once orders are delivered.</p>
      <% } else { %>
        <div class="ops-health-grid">
          <div class="ops-health-card">
            <span>Average</span>
            <strong><%= fulfillment.averageMinutes %> min</strong>
          </div>
          <div class="ops-health-card">
            <span>Fastest</span>
            <strong><%= fulfillment.fastestMinutes %> min</strong>
          </div>
          <div class="ops-health-card">
            <span>Slowest</span>
            <strong><%= fulfillment.slowestMinutes %> min</strong>
          </div>
          <div class="ops-health-card">
            <span>Fulfilled</span>
            <strong><%= fulfillment.fulfilledCount %></strong>
          </div>
        </div>
      <% } %>
    </section>

    <section class="ops-panel">
      <div class="ops-panel-head">
        <div>
          <span class="ops-panel-kicker">Attention</span>
          <h2>Items needing attention</h2>
        </div>
        <span class="ops-chip"><%= (safeDashboard.itemsNeedingAttention || []).length %> flagged</span>
      </div>

      <% if (!safeDashboard.itemsNeedingAttention || safeDashboard.itemsNeedingAttention.length === 0) { %>
        <p class="ops-empty">Every item is available. Nothing needs attention right now.</p>
      <% } else { %>
        <div class="ops-attention-list">
          <% safeDashboard.itemsNeedingAttention.forEach((item) => { %>
            <div class="ops-attention-row">
              <div>
                <strong><%= item.name %></strong>
                <span><%= item.category %></span>
              </div>
              <span class="ops-attention-status status-<%= item.status.toLowerCase().replace(' ', '-') %>"><%= item.status %></span>
            </div>
          <% }) %>
        </div>
      <% } %>
    </section>
  </div>

  <section class="ops-panel ops-panel-wide">
      <div class="ops-panel-head">
        <div>
          <span class="ops-panel-kicker">Menu control</span>
          <h2>Inventory workspace</h2>
        </div>
      <span class="ops-chip"><%= canManage ? "Drag to reorder inventory cards" : "Previewing inventory cards" %></span>
    </div>

    <div class="admin-filters ops-admin-filters">
      <input
        type="text"
        id="searchInput"
        placeholder="Search menu items..."
      />

      <select id="categoryFilter">
        <option value="all">All Categories</option>
        <option value="Starter">Starter</option>
        <option value="Main">Main</option>
        <option value="Dessert">Dessert</option>
        <option value="Drinks">Drinks</option>
      </select>
    </div>

    <div class="admin-grid ops-admin-grid" id="menuGrid">
      <% safeMenuItems.forEach((item) => { %>
        <div
          class="admin-card ops-menu-card"
          data-id="<%= item.id %>"
          data-name="<%= item.name.toLowerCase() %>"
          data-category="<%= item.category %>"
        >
          <% if (canManage) { %>
            <div class="drag-handle">::</div>
          <% } %>

          <% if (item.image_url) { %>
            <img
              src="<%= item.image_url %>"
              alt="<%= item.name %>"
              class="admin-card-image"
              loading="lazy"
            />
          <% } else { %>
            <div class="admin-card-placeholder">No Image</div>
          <% } %>

          <div class="admin-card-body">
            <h3><%= item.name %></h3>
            <p class="admin-price"><%= formatCurrency(item.price) %></p>
            <p class="admin-category"><%= item.category %></p>

            <% if (canManage) { %>
              <button
                class="status-btn <%= (item.status || 'available').toLowerCase().replace(' ', '-') %>"
                data-id="<%= item.id %>"
              >
                <%= item.status || "Available" %>
              </button>
            <% } else { %>
              <span class="status-btn <%= (item.status || 'available').toLowerCase().replace(' ', '-') %>">
                <%= item.status || "Available" %>
              </span>
            <% } %>

            <div class="admin-actions">
              <% if (canManage) { %>
                <a href="/admin/edit/<%= item.id %>" class="edit-btn">Edit</a>

                <form
                  action="/admin/delete/<%= item.id %>"
                  method="POST"
                  onsubmit="return confirm('Delete this item?')"
                >
                  <button type="submit" class="delete-btn">Delete</button>
                </form>
              <% } else { %>
                <a href="/auth/login" class="edit-btn">Login to Edit</a>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </section>
</section>

<div id="toast" class="toast hidden">Saved</div>

<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
<script>
  const canManage = <%= canManage ? "true" : "false" %>;
  const searchInput = document.getElementById("searchInput");
  const categoryFilter = document.getElementById("categoryFilter");
  const cards = document.querySelectorAll(".admin-card");

  function filterItems() {
    const search = searchInput.value.toLowerCase();
    const category = categoryFilter.value;

    cards.forEach((card) => {
      const name = card.dataset.name;
      const cardCategory = card.dataset.category;
      const matchesSearch = name.includes(search);
      const matchesCategory = category === "all" || cardCategory === category;

      card.style.display = matchesSearch && matchesCategory ? "block" : "none";
    });
  }

  searchInput.addEventListener("input", filterItems);
  categoryFilter.addEventListener("change", filterItems);

  const grid = document.getElementById("menuGrid");

  if (canManage) {
    new Sortable(grid, {
      animation: 150,
      handle: ".drag-handle",
      onEnd: async function () {
        const order = [];

        document.querySelectorAll("#menuGrid .admin-card").forEach((card) => {
          order.push(card.dataset.id);
        });

        try {
          await fetch("/admin/menu/reorder", {
            method: "POST",
            headers: {
              "Content-Type": "application/json"
            },
            body: JSON.stringify({ order })
          });

          showToast("Order updated");
        } catch (err) {
          console.error("Order update failed", err);
        }
      }
    });
  }

  function showToast(message = "Saved") {
    const toast = document.getElementById("toast");
    toast.textContent = message;
    toast.classList.remove("hidden");

    setTimeout(() => {
      toast.classList.add("show");
    }, 10);

    setTimeout(() => {
      toast.classList.remove("show");

      setTimeout(() => {
        toast.classList.add("hidden");
      }, 300);
    }, 2000);
  }

  if (canManage) {
    document.querySelectorAll("button.status-btn").forEach((button) => {
      button.addEventListener("click", async () => {
        const id = button.dataset.id;

        try {
          const res = await fetch(`/admin/menu/${id}/toggle-status`, {
            method: "POST"
          });

          const data = await res.json();

          if (data.success) {
            button.textContent = data.status;
            button.className = "status-btn " + data.status.toLowerCase().replace(" ", "-");
            showToast("Status updated");
          }
        } catch (err) {
          console.error("Status update failed", err);
        }
      });
    });
  }
</script>

<%- include("../partials/footer") %>
