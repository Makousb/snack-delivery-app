<aside class="marketplace-side-menu" aria-label="Driver menu">
  <nav class="side-menu-section" aria-label="Dashboard sections">
    <span class="side-menu-section-title">Workspace</span>
    <a href="#driver-top" class="side-menu-link side-menu-link-active">
      <span class="side-menu-icon" aria-hidden="true">D</span>
      <span>Dashboard</span>
    </a>
    <a href="#driver-profile" class="side-menu-link">
      <span class="side-menu-icon" aria-hidden="true">P</span>
      <span>Profile</span>
    </a>
    <a href="#driver-tips" class="side-menu-link">
      <span class="side-menu-icon" aria-hidden="true">$</span>
      <span>Tips</span>
    </a>
    <a href="#driver-available" class="side-menu-link">
      <span class="side-menu-icon" aria-hidden="true">A</span>
      <span>Available Orders</span>
    </a>
    <a href="#driver-active" class="side-menu-link">
      <span class="side-menu-icon" aria-hidden="true">J</span>
      <span>Active Journey</span>
    </a>
    <a href="#driver-history" class="side-menu-link">
      <span class="side-menu-icon" aria-hidden="true">H</span>
      <span>History</span>
    </a>
  </nav>

  <nav class="side-menu-section" aria-label="Account links">
    <span class="side-menu-section-title">Account</span>
    <button type="button" class="side-menu-link" data-theme-toggle>
      <span class="side-menu-icon" aria-hidden="true">T</span>
      <span>Dark Mode</span>
    </button>
  </nav>

  <div class="side-menu-account">
    <% if (typeof currentUser !== "undefined" && currentUser) { %>
      <span class="side-menu-avatar" aria-hidden="true"><%= currentUser.email.charAt(0).toUpperCase() %></span>
      <div>
        <strong><%= currentUser.email %></strong>
        <a href="/auth/logout">Logout</a>
      </div>
    <% } %>
  </div>
</aside>
