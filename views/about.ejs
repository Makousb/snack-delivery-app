<%- include("partials/header", { title: "About Snack" }) %>

<section class="auth-shell auth-shell-compact">
  <div class="auth-hero">
    <span class="feature-eyebrow">About</span>
    <h1>A delivery marketplace built around three roles.</h1>
    <p>
      Snack connects independent restaurants with hungry customers and the
      drivers who get orders there.
    </p>
  </div>

  <div class="auth-form-card">
    <p>
      <strong>Customers</strong> browse restaurants, build a cart, and check
      out with cash or M-Pesa, then track each order in real time.
    </p>
    <p>
      <strong>Restaurant owners</strong> get a business hub to manage their
      menu, profile, and incoming orders without touching any code.
    </p>
    <p>
      <strong>Drivers</strong> pick up available deliveries from a dedicated
      dashboard and update the delivery stage as they go.
    </p>
    <p>
      Have a question we didn't answer here? <a href="/contact">Get in touch</a>.
    </p>
  </div>
</section>

<%- include("partials/footer") %>
