<%- include("partials/header", { title: "Contact Us" }) %>

<section class="auth-shell auth-shell-compact">
  <div class="auth-hero">
    <span class="feature-eyebrow">Get in touch</span>
    <h1>Questions, feedback, or a partnership idea?</h1>
    <p>
      Send us a message and our team will get back to you.
    </p>
  </div>

  <form action="/contact" method="POST" class="auth-form auth-form-card">
    <div>
      <label for="name">Name</label>
      <input type="text" id="name" name="name" required />
    </div>

    <div>
      <label for="email">Email</label>
      <input type="email" id="email" name="email" required />
    </div>

    <div>
      <label for="message">Message</label>
      <textarea id="message" name="message" rows="5" required></textarea>
    </div>

    <button type="submit">Send Message</button>
  </form>
</section>

<%- include("partials/footer") %>
