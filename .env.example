# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
NODE_ENV=development
PORT=3000
# Required in production; any random long string works in development.
SESSION_SECRET=change-me-to-a-long-random-string

# --- Google Maps (optional, used for address autocomplete) ---
GOOGLE_MAPS_API_KEY=

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=business_data
DB_SSL=false

# --- M-Pesa (Safaricom Daraja STK Push) ---
# Online payments are off by default (cash-on-delivery only) so a beta can run
# safely without exposing the unauthenticated Daraja callback. Set to "true"
# only once you have real credentials AND have secured the callback endpoint.
MPESA_ENABLED=false
# Sandbox URL by default; switch to the production endpoint when you go live.
MPESA_STK_PUSH_URL=https://sandbox.safaricom.co.ke/mpesa/stkpush/v1/processrequest
MPESA_ACCESS_TOKEN=
MPESA_BUSINESS_SHORT_CODE=174379
# This is the Lipa Na M-Pesa Online Passkey, despite the generic name.
MPESA_PASSWORD=
MPESA_CALLBACK_URL=https://yourdomain.com/api/mpesa/callback

# --- Email (optional, transactional order confirmations) ---
# Off by default. When enabled, signed-in customers get an order confirmation
# email. Leave EMAIL_ENABLED unset/false to run without sending any mail.
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS), false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Snack <no-reply@yourdomain.com>
